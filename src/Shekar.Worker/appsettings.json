  "ConnectionStrings": {
    "Shekar": "Server=localhost;Database=Shekar;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "_comment_CrawlProvider": "Mock = داده‌ی نمونه (پیش‌فرض). Divar = کراولر واقعی HTML دیوار.",
  "Crawl": {
    "Provider": "Mock",
    "IntervalMinutes": 15,
    "StartJitterSeconds": 300,
    "MaxAgeHours": 24,
