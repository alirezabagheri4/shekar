{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Quartz": "Warning"
    }
  },

  "_comment_Persistence": "Mock = درون‌حافظه (پیش‌فرض). SqlServer = EF Core 6 (برای اشتراک داده با Web).",
  "Persistence": "Mock",
  "ConnectionStrings": {
    "Shekar": "Server=localhost;Database=Shekar;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Crawl": {
    "IntervalMinutes": 5,
    "MaxAgeHours": 24
  },
  "Aggregate": {
    "IntervalMinutes": 60,
    "WindowDays": 30,
    "NormalizeBatch": 5000
  }
}
