    "StaleAfterHours": 72,
    "Polite": {
      "MinDelaySeconds": 5,
      "MaxDelaySeconds": 16,
      "LongPauseEveryRequests": 7,
      "LongPauseMinSeconds": 40,
      "LongPauseMaxSeconds": 120,
      "MaxPagesPerRun": 2,
