@model AccountViewModel
@{
    ViewData["Title"] = "حساب کاربری";
    var planLabel = Model.Status.PlanType == PlanType.HunterPro ? "شکارچی حرفه‌ای · ماهانه"
        : Model.Status.PlanType == PlanType.Hunter ? "شکارچی · ماهانه" : "بدون اشتراک";
    var initial = string.IsNullOrEmpty(Model.FullName) ? "؟" : Model.FullName.Substring(0, 1);
    var verdictStyle = (string v) => v switch
    {
        "فرصت طلایی" => "background: #D4A017; color: #111827",
        "گران" => "background: #FEE2E2; color: #B91C1C",
        _ => "background: #E6F4F1; color: #0F766E"
    };
    var catLabels = Model.Categories.ToDictionary(c => c.Category, c => c.Label);
    int progressPct = Model.Status.IsSubscriber ? Math.Clamp(Model.DaysRemaining * 100 / 30, 0, 100) : 0;
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/account.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #F6F8F8; display: flex; flex-direction: column">
<main style="padding: 20px 16px; display: flex; flex-direction: column; gap: 14px; flex: 1">
<h1 style="margin: 0; font-size: 22px; font-weight: 800">حساب کاربری</h1>
<section class="zbox" aria-label="پروفایل" style="flex-direction: row; align-items: center">
<span aria-hidden="true" style="width: 56px; height: 56px; border-radius: 50%; background: #0F766E; color: #FFFFFF; display: grid; place-items: center; font-weight: 800; font-size: 20px; flex: none">@initial</span>
<div style="flex: 1; display: flex; flex-direction: column; gap: 2px"><b>@Model.FullName</b><span dir="ltr" style="color: #6B7280; font-size: 13px; text-align: right">@ViewFormat.Digits(Model.Mobile) · @Model.CityName</span></div>
<a href="/login/profile" style="min-height: 44px; display: flex; align-items: center; font-weight: 700; font-size: 14px">ویرایش</a>
</section>

<section class="zbox" aria-labelledby="h2" style="border: 2px solid #0F766E">
<h2 id="h2" style="margin: 0; font-size: 16px">پلن فعلی</h2>
<div style="display: flex; flex-direction: column; gap: 12px">
<div><b style="font-size: 18px">@planLabel</b>
@if (Model.Status.IsSubscriber)
{
    <div style="color: #6B7280; font-size: 13px; margin-top: 4px">اعتبار تا @Model.ExpiresLabel · <b style="color: #DC2626">@ViewFormat.Digits(Model.DaysRemaining.ToString()) روز مانده</b></div>
}
</div>
<div style="height: 8px; background: #E6F4F1; border-radius: 8px; overflow: hidden"><div style="width: @(progressPct)%; height: 100%; background: #0F766E"></div></div>
<div style="display: flex; gap: 10px"><a href="/plans" class="zbtn zbtn-p">تمدید</a></div>
</div>
</section>

<section class="zbox" aria-labelledby="h3">
<h2 id="h3" style="margin: 0; font-size: 16px">هشدارهای «خبرم کن»</h2>
<p style="margin: 0; font-size: 13px; color: #374151; background: #E6F4F1; border-radius: 12px; padding: 10px 12px; line-height: 1.8">هر زنگوله‌ای که روشن کنی، تا ۲۴ ساعت شکارهای تازه‌ش رو پیامک می‌کنیم؛ بعدش خودش خاموش می‌شه.</p>
<div style="display: flex; flex-direction: column">
@{int bi = 0;}
@foreach (var bell in Model.Bells)
{
    var lid = $"am{bi++}";
    <div style="display: flex; justify-content: space-between; align-items: center; min-height: 52px; border-bottom: 1px solid #EEF0F2">
    <span style="display: flex; flex-direction: column; gap: 2px">
    <span id="@lid" style="font-size: 15px">@catLabels.GetValueOrDefault(bell.Category, bell.Category.ToString())</span>
    @if (bell.IsOn)
    {
        <span style="font-size: 12px; color: #0F766E">فعال · @bell.RemainingLabel</span>
    }
    else
    {
        <span style="font-size: 12px; color: #6B7280">خاموش</span>
    }
    </span>
    <form method="post" action="/bells/toggle" style="margin: 0">
    <input type="hidden" name="category" value="@bell.Category" />
    <input type="hidden" name="returnUrl" value="/account" />
    <button role="switch" aria-checked="@(bell.IsOn ? "true" : "false")" aria-labelledby="@lid" class="zsw@(bell.IsOn ? " zsw-on" : "")" type="submit"></button>
    </form>
    </div>
}
</div>
</section>

<section class="zbox" aria-labelledby="h4">
<div style="display: flex; justify-content: space-between; align-items: center"><h2 id="h4" style="margin: 0; font-size: 16px">کارشناسی‌ها</h2><span style="background: #E6F4F1; color: #0F766E; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 999px">@(Model.Status.IsSubscriber ? "نامحدود" : "ماهی ۳ رایگان")</span></div>
<ul style="list-style: none; margin: 0; padding: 0">
@foreach (var a in Model.Appraisals)
{
    <li style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #EEF0F2"><div><b style="display: block; font-size: 14px">@a.Title</b><span style="font-size: 12px; color: #6B7280">@a.DateLabel · امتیاز @ViewFormat.Digits(a.Score.ToString())</span></div><span style="font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; @verdictStyle(a.Verdict)">@a.Verdict</span></li>
}
</ul>
</section>

<a href="/contact" style="background: #FFFFFF; border-radius: 14px; min-height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; color: #111827; font-weight: 600">تماس با ما<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
<form method="post" action="/logout" style="margin: 0"><button type="submit" style="width: 100%; border: 0; cursor: pointer; background: #FFFFFF; border-radius: 14px; min-height: 52px; display: flex; align-items: center; justify-content: center; gap: 8px; color: #DC2626; font-weight: 700; font-family: inherit"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"></path></svg>خروج از حساب</button></form>
</main>
<nav aria-label="منوی پایین" style="position: sticky; bottom: 0; background: #FFFFFF; border-top: 1px solid #EEF0F2; display: flex; padding: 4px 8px 14px">
<a href="/categories" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg>شکارها</a>
<a href="/appraise" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg>کارشناسی</a>
<a href="/plans" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 10h18"></path></svg>پلن‌ها</a>
<a href="/account" class="znav znav-on" aria-current="page"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>حساب</a>
</nav>
</div>
