@model HuntDetailViewModel
@{
    ViewData["Title"] = "جزئیات آگهی";
    var c = Model.Detail.Card;
    var d = Model.Detail;
    var ringColor = c.IsGolden ? "#D4A017" : "#0F766E";
    string Mil(long v) => ViewFormat.Number(v / 1_000_000) + " میلیون";
    string BarColor(int s) => s >= 80 ? "#0F766E" : s >= 60 ? "#14B8A6" : s >= 40 ? "#F59E0B" : "#EF4444";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/hunt-detail.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh">
<header style="position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid #EEF0F2">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 32px; min-height: 72px; display: flex; align-items: center; gap: 36px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827"><svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 22px">شکار</b></a>
<nav aria-label="منوی اصلی" style="display: flex; gap: 28px; flex: 1"><a href="/hunts" aria-current="page" style="color: #0F766E; font-weight: 700">شکارها</a><a href="/appraise" style="color: #374151; font-weight: 500">ارزیابی آگهی</a><a href="/plans" style="color: #374151; font-weight: 500">پلن‌ها</a><a href="/contact" style="color: #374151; font-weight: 500">تماس با ما</a></nav>
<a href="/account" aria-label="حساب کاربری" style="width: 44px; height: 44px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></a>
</div>
</header>

<div style="max-width: 1280px; margin: 0 auto; padding: 20px 24px 80px; display: flex; flex-direction: column; gap: 20px">
<a href="/hunts" style="align-self: flex-start; display: flex; align-items: center; gap: 6px; font-weight: 600; min-height: 44px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>بازگشت به شکارها</a>

<div style="display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">
@* ── ستون اصلی (چپ‌چین) ── *@
<div style="flex: 999 1 600px; min-width: 0; display: flex; flex-direction: column; gap: 24px">

@* ── lightbox overlay ── *@
<div id="zlight" onclick="this.style.display='none'" style="display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.92);cursor:zoom-out;align-items:center;justify-content:center">
<img id="zlightimg" src="" alt="تصویر بزرگ خودرو" style="max-width:96%;max-height:96%;object-fit:contain;border-radius:12px">
<button onclick="event.stopPropagation();document.getElementById('zlight').style.display='none'" aria-label="بستن" style="position:absolute;top:16px;left:16px;background:#fff;border:0;border-radius:50%;width:44px;height:44px;font-size:22px;cursor:pointer;display:grid;place-items:center;font-family:inherit">×</button>
</div>

@* ── گالری عکس ── *@
<div style="display: flex; flex-direction: column; gap: 12px">
<div style="height: 280px; border-radius: 20px; background: #EEF2F2; display: grid; place-items: center; position: relative; overflow: hidden; cursor: zoom-in" onclick="var l=document.getElementById('zlight');var s='@(!string.IsNullOrEmpty(c.ImageFileName) ? "/assets/ads/" + c.ImageFileName : "")';if(s){document.getElementById('zlightimg').src=s;l.style.display='flex'}">
@if (!string.IsNullOrEmpty(c.ImageFileName))
{
    <img src="~/assets/ads/@c.ImageFileName" alt="تصویر آگهی" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none">
}
else
{
    <svg viewBox="0 0 400 170" width="70%" aria-hidden="true"><path d="M18 128 L24 104 Q30 88 62 84 L122 78 L166 48 Q178 40 198 40 L262 40 Q284 40 300 54 L332 80 L366 86 Q386 90 388 106 L390 126 Q390 134 380 134 L28 134 Q18 134 18 128 Z" fill="#F3F4F6" stroke="#94A3A8" stroke-width="2"></path><circle cx="96" cy="134" r="26" fill="#111827"></circle><circle cx="316" cy="134" r="26" fill="#111827"></circle></svg>
}
@if (d.ImageCount > 0)
{
    <span style="position: absolute; bottom: 14px; left: 14px; background: rgba(17,24,39,.7); color: #FFFFFF; font-size: 13px; padding: 4px 10px; border-radius: 999px">@ViewFormat.Digits("۱") از @ViewFormat.Digits(d.ImageCount.ToString())</span>
}
@if (c.IsGolden)
{
    <span style="position: absolute; top: 14px; right: 14px; background: #D4A017; color: #111827; font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 999px">فرصت طلایی</span>
}
</div>
@if (d.ImageCount > 1)
{
<div style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 4px">
<button class="zthumb zthumb-on" aria-label="تصویر اصلی" aria-pressed="true">
@if (!string.IsNullOrEmpty(c.ImageFileName))
{
    <img src="~/assets/ads/@c.ImageFileName" alt="" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px">
}
</button>
@for (int i = 1; i < d.ImageCount && i < 6; i++)
{
    <button class="zthumb" aria-label="تصویر @ViewFormat.Digits((i+1).ToString())" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle></svg></button>
}
</div>
}
</div>

@* ── عنوان و قیمت ── *@
<div style="display: flex; flex-direction: column; gap: 10px">
<h1 style="margin: 0; font-size: 28px; font-weight: 800; line-height: 1.5">@c.Title</h1>
<div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap">
<span style="font-size: 30px; font-weight: 800">@ViewFormat.Number(c.PriceToman) <span style="font-size: 16px; font-weight: 500; color: #6B7280">تومان</span></span>
<span style="background: #E6F4F1; color: #0F766E; font-weight: 700; padding: 4px 12px; border-radius: 8px">@ViewFormat.Digits(c.BelowMarketPercent.ToString())٪ زیر بازار</span>
</div>
<span style="color: #6B7280; display: flex; gap: 8px; align-items: center"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>@ViewFormat.RelativeTime(c.PublishedAt, Model.Now) در تهران، @c.Location</span>
</div>

@* ── مشخصات خودرو ── *@
<section class="zcardb" aria-labelledby="sp">
<h2 id="sp" style="margin: 0 0 12px; font-size: 20px">مشخصات</h2>
<dl style="margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); column-gap: 32px">
@if (c.MileageKm is not null)
{
    <div class="zspec-row"><dt>کارکرد</dt><dd>@ViewFormat.Digits(c.MileageKm.Value.ToString("N0")) کیلومتر</dd></div>
}
else
{
    <div class="zspec-row"><dt>کارکرد</dt><dd>صفر کیلومتر</dd></div>
}
<div class="zspec-row"><dt>مدل (سال تولید)</dt><dd>@c.ModelYear</dd></div>
@if (!string.IsNullOrEmpty(d.Color))
{
    <div class="zspec-row"><dt>رنگ</dt><dd>@d.Color</dd></div>
}
@if (!string.IsNullOrEmpty(d.BrandModel))
{
    <div class="zspec-row"><dt>برند و مدل</dt><dd>@d.BrandModel</dd></div>
}
@if (d.InsuranceMonths.HasValue)
{
    <div class="zspec-row"><dt>مهلت بیمه‌ی شخص ثالث</dt><dd>@ViewFormat.Digits(d.InsuranceMonths.Value.ToString()) ماه</dd></div>
}
@if (!string.IsNullOrEmpty(d.GearboxType))
{
    <div class="zspec-row"><dt>نوع گیربکس</dt><dd>@d.GearboxType</dd></div>
}
@if (!string.IsNullOrEmpty(d.FuelType))
{
    <div class="zspec-row"><dt>نوع سوخت</dt><dd>@d.FuelType</dd></div>
}
@if (d.BasePriceToman.HasValue)
{
    <div class="zspec-row"><dt>قیمت پایه</dt><dd>@ViewFormat.PriceToman(d.BasePriceToman.Value)</dd></div>
}
@if (!string.IsNullOrEmpty(d.EngineCondition))
{
    <div class="zspec-row"><dt>وضعیت موتور</dt><dd>@d.EngineCondition</dd></div>
}
@if (!string.IsNullOrEmpty(d.ChassisCondition))
{
    <div class="zspec-row"><dt>وضعیت شاسی‌ها</dt><dd>@d.ChassisCondition</dd></div>
}
@if (!string.IsNullOrEmpty(d.BodyConditionText))
{
    <div class="zspec-row"><dt>وضعیت بدنه</dt><dd>@d.BodyConditionText</dd></div>
}
@if (!string.IsNullOrEmpty(d.GearboxCondition))
{
    <div class="zspec-row"><dt>وضعیت گیربکس</dt><dd>@d.GearboxCondition</dd></div>
}
</dl>
</section>

@* ── درخواست کارشناسی حضوری ── *@
<div class="zcardb" style="padding: 8px 20px">
<button type="button" class="zrow" style="border-bottom: 0; background: none; border-top: 0; width: 100%; text-align: right; font-family: inherit; font-size: inherit; color: inherit; cursor: pointer"><span style="display: flex; gap: 12px; align-items: center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle></svg>درخواست کارشناسی حضوری خودرو</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
</div>

@* ── توضیحات فروشنده ── *@
@if (!string.IsNullOrEmpty(d.SellerDescription))
{
<section class="zcardb" aria-labelledby="sd" style="display: flex; flex-direction: column; gap: 12px">
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap">
<h2 id="sd" style="margin: 0; font-size: 20px">توضیحات فروشنده</h2>
@if (!string.IsNullOrEmpty(d.SellerName))
{
    <span style="background: #F6F8F8; padding: 6px 12px; border-radius: 999px; font-size: 13px">فروشنده · @d.SellerName</span>
}
</div>
<p style="margin: 0; line-height: 1.9; color: #374151">@d.SellerDescription</p>
</section>
}

@* ── موقعیت ── *@
<section class="zcardb" aria-labelledby="mp" style="display: flex; flex-direction: column; gap: 12px">
<h2 id="mp" style="margin: 0; font-size: 20px">موقعیت</h2>
<div style="height: 240px; border-radius: 14px; background: #F1F5F4; position: relative; overflow: hidden">
<svg width="100%" height="100%" viewBox="0 0 800 240" preserveAspectRatio="xMidYMid slice" role="img" aria-label="نقشه‌ی موقعیت تقریبی: تهران، @c.Location"><path d="M0 60 L800 90 M0 170 L800 140 M140 0 L180 240 M420 0 L400 240 M640 0 L690 240" stroke="#FFFFFF" stroke-width="14"></path><path d="M0 115 Q300 80 800 120" stroke="#FDE68A" stroke-width="10" fill="none"></path><rect x="470" y="160" width="120" height="70" rx="10" fill="#D7EDE6"></rect><circle cx="400" cy="112" r="46" fill="#0F766E" opacity=".14"></circle><path d="M400 70c-14 0-24 10-24 23 0 17 24 39 24 39s24-22 24-39c0-13-10-23-24-23z" fill="#0F766E"></path><circle cx="400" cy="93" r="8" fill="#FFFFFF"></circle></svg>
</div>
<span style="color: #6B7280; font-size: 14px">تهران، @c.Location — موقعیت تقریبی</span>
</section>
</div>

@* ── سایدبار (سمت چپ) ── *@
<aside style="flex: 1 1 380px; max-width: 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px; position: sticky; top: 92px; align-self: flex-start; max-height: calc(100vh - 108px); overflow-y: auto">

@* ── امتیاز شکار ── *@
<section class="zcardb" aria-labelledby="sc" style="display: flex; flex-direction: column; gap: 16px">
<div style="display: flex; justify-content: space-between; align-items: center"><h2 id="sc" style="margin: 0; font-size: 18px">امتیاز شکار</h2><span style="font-size: 12px; color: #6B7280">بر اساس @ViewFormat.Digits(d.ComparableCount.ToString()) آگهی مشابه</span></div>
<div style="display: flex; align-items: center; gap: 20px">
<span style="position: relative; display: inline-grid; place-items: center; flex: none; width: 124px; height: 124px"><svg width="124" height="124" viewBox="0 0 128 128" role="img" aria-label="امتیاز شکار @ViewFormat.Digits(c.Score.ToString()) از ۱۰۰"><circle cx="64" cy="64" r="54" fill="none" stroke="#F3F4F6" stroke-width="12"></circle><circle cx="64" cy="64" r="54" fill="none" stroke="@ringColor" stroke-width="12" stroke-linecap="round" class="zring" stroke-dasharray="@(c.Score * 3.393) 339.3" transform="rotate(-90 64 64)"></circle></svg><span aria-hidden="true" style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1"><b style="font-size: 36px; font-weight: 800; color: #111827">@ViewFormat.Digits(c.Score.ToString())</b><span style="font-size: 12px; color: #6B7280">از ۱۰۰</span></span></span>
<div style="display: flex; flex-direction: column; gap: 6px; min-width: 0">
@if (c.IsGolden)
{
    <span style="align-self: flex-start; background: #D4A017; color: #111827; font-weight: 800; font-size: 13px; padding: 3px 12px; border-radius: 999px">فرصت طلایی</span>
}
<b style="font-size: 14px; line-height: 1.7">از @ViewFormat.Digits((100 - c.Score + 5).ToString())٪ آگهی‌های مشابه بهتره</b>
<span style="font-size: 13px; color: #6B7280; line-height: 1.7">@d.Summary</span>
</div>
</div>

@* ── فاکتورها با progress bar ── *@
<div style="display: flex; flex-direction: column; gap: 12px">
@foreach (var f in d.Factors)
{
    var barColor = BarColor(f.Score);
    <div style="display: flex; flex-direction: column; gap: 6px">
    <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14px"><b>@f.Name</b><span style="display: inline-flex; align-items: center; gap: 6px"><span style="font-size: 12px; font-weight: 700; color: @barColor">@f.Rating</span><b style="min-width: 26px; text-align: left">@ViewFormat.Digits(f.Score.ToString())</b></span></div>
    <div style="height: 8px; background: #F3F4F6; border-radius: 8px; overflow: hidden"><div class="zbarw" style="height: 100%; width: @(f.Score)%; background: @barColor; border-radius: 8px"></div></div>
    <span style="font-size: 12px; color: #6B7280">@f.Detail</span>
    </div>
}
</div>
</section>

@* ── حساب‌وکتاب سود ── *@
<section class="zcardb" aria-labelledby="mk" style="display: flex; flex-direction: column; gap: 16px">
<div style="display: flex; justify-content: space-between; align-items: center"><h2 id="mk" style="margin: 0; font-size: 18px">حساب‌وکتاب سود</h2><span style="font-size: 12px; color: #0F766E; font-weight: 700">اطمینان: @d.Confidence</span></div>
<div style="padding-top: 32px; position: relative">
@{
    double fairMin = d.FairRangeMinToman > 0 ? d.FairRangeMinToman : c.MarketMedianToman * 0.95;
    double fairMax = d.FairRangeMaxToman > 0 ? d.FairRangeMaxToman : c.MarketMedianToman * 1.05;
    double totalRange = fairMax * 1.15;
    double adPct = totalRange > 0 ? (c.PriceToman / totalRange * 100) : 20;
    adPct = Math.Clamp(adPct, 5, 95);
}
<div style="position: absolute; top: 0; left: @(adPct)%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center"><span style="background: #111827; color: #FFFFFF; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 8px; white-space: nowrap">این آگهی</span><span style="width: 2px; height: 12px; background: #111827"></span></div>
<div style="display: flex; height: 10px; border-radius: 999px; overflow: hidden; gap: 4px"><span style="flex: 1; background: #FCA5A5"></span><span style="flex: 1.2; background: #5EEAD4"></span><span style="flex: 1; background: #D4A017"></span></div>
<div style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 11px; color: #6B7280"><span>گرون</span><span>منصفانه · @ViewFormat.Price(d.FairRangeMinToman) تا @ViewFormat.Price(d.FairRangeMaxToman)</span><span style="color: #8A6A0B; font-weight: 700">فرصت طلایی</span></div>
</div>
<dl style="margin: 0; display: flex; flex-direction: column; font-size: 14px">
<div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #EEF0F2"><dt style="color: #6B7280">میانه‌ی قیمت بازار</dt><dd style="margin: 0; font-weight: 700">@Mil(c.MarketMedianToman)</dd></div>
<div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #EEF0F2"><dt style="color: #6B7280">قیمت این آگهی</dt><dd style="margin: 0; font-weight: 700">− @Mil(c.PriceToman)</dd></div>
<div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #EEF0F2"><dt style="color: #6B7280">هزینه‌ی نقل‌وانتقال و فروش</dt><dd style="margin: 0; font-weight: 700">− @Mil(d.TransactionCostToman)</dd></div>
</dl>
<div style="display: flex; justify-content: space-between; align-items: center; background: #0F766E; color: #FFFFFF; border-radius: 14px; padding: 12px 14px">
<span style="display: flex; flex-direction: column"><span style="font-size: 12px; color: #CDEBE5">سود خالص تخمینی</span><b style="font-size: 22px">@Mil(c.EstimatedProfitToman) تومان</b></span>
@if (d.ResellDaysMin.HasValue && d.ResellDaysMax.HasValue)
{
    <span style="text-align: left; font-size: 12px; color: #CDEBE5; line-height: 1.6">فروش دوباره<br><b style="color: #FFFFFF; font-size: 13px">@ViewFormat.Digits(d.ResellDaysMin.Value.ToString()) تا @ViewFormat.Digits(d.ResellDaysMax.Value.ToString()) روز</b></span>
}
</div>
</section>

@* ── برچسب‌های ریسک ── *@
@if (d.Risks.Count > 0)
{
<section class="zcardb" aria-labelledby="rk" style="display: flex; flex-direction: column; gap: 12px">
<h2 id="rk" style="margin: 0; font-size: 18px">برچسب‌های ریسک</h2>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
@foreach (var r in d.Risks)
{
    var isPositive = r.Contains("سند") || r.Contains("بیمه") || r.Contains("سالم") || r.Contains("نقدشوندگی");
    <span class="@(isPositive ? "zrisk-pos" : "zrisk-neg")">@r</span>
}
</div>
</section>
}

@* ── دکمه CTA ── *@
<div style="display: flex; flex-direction: column; gap: 10px">
@if (!string.IsNullOrEmpty(d.SourceUrl))
{
    <a href="@d.SourceUrl" target="_blank" rel="noopener" class="zbtn zbtn-p">تماس از طریق آگهی اصلی<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"></path></svg></a>
}
else
{
    <a href="#" class="zbtn zbtn-p">تماس از طریق آگهی اصلی<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"></path></svg></a>
}
<p style="margin: 0; font-size: 12px; color: #6B7280; text-align: center">قیمت و سود تخمینیه و تضمینی نیست؛ قبل از خرید حتماً کارشناسی کن.</p>
</div>
</aside>
</div>
</div>
</div>
