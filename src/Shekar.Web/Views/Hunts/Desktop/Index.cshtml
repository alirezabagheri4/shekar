@model HuntsViewModel
@{
    ViewData["Title"] = "شکارها";
    ViewData["Now"] = Model.Now;
    var planLabel = Model.Status.PlanType == PlanType.HunterPro ? "شکارچی حرفه‌ای"
        : Model.Status.PlanType == PlanType.Hunter ? "شکارچی" : "—";
    int total = Model.Categories.Sum(c => c.TodayCount);
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/hunts.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh; position: relative">
<header style="position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid #EEF0F2">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 32px; min-height: 72px; display: flex; align-items: center; gap: 36px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827"><svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 22px">شکار</b></a>
<nav aria-label="منوی اصلی" style="display: flex; gap: 28px; flex: 1"><a href="/hunts" aria-current="page" style="color: #0F766E; font-weight: 700">شکارها</a><a href="/appraise" style="color: #374151; font-weight: 500">ارزیابی آگهی</a><a href="/plans" style="color: #374151; font-weight: 500">پلن‌ها</a><a href="/contact" style="color: #374151; font-weight: 500">تماس با ما</a></nav>
<span style="font-size: 13px; background: #F6F8F8; padding: 6px 12px; border-radius: 999px; color: #6B7280">پلن: <b style="color: #111827">@planLabel</b></span>
<a href="/account" aria-label="حساب کاربری" style="width: 44px; height: 44px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></a>
</div>
</header>

<div style="max-width: 1360px; margin: 0 auto; padding: 28px 24px 80px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">
<aside aria-label="دسته‌بندی قیمتی" style="flex: 1 1 300px; max-width: 320px; display: flex; flex-direction: column; gap: 4px; border: 1px solid #E5E7EB; border-radius: 20px; padding: 14px; background: #FFFFFF; box-shadow: 0 10px 30px rgba(17,24,39,.04); position: sticky; top: 88px; align-self: flex-start; max-height: calc(100vh - 108px); overflow-y: auto">
<div style="display: flex; justify-content: space-between; align-items: center; padding: 2px 6px 10px"><b style="font-size: 17px">دسته‌ی قیمتی</b><span style="font-size: 12px; color: #6B7280">قیمت به تومان</span></div>

<div style="display: flex; gap: 6px; align-items: center">
<a href="/hunts" class="zcat@(Model.List.Category is null ? " zcat-on" : "")" aria-pressed="@(Model.List.Category is null ? "true" : "false")">
<span class="zthumb" style="background: #0F766E; display: grid; place-items: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="2"></rect><rect x="13" y="4" width="7" height="7" rx="2"></rect><rect x="4" y="13" width="7" height="7" rx="2"></rect><rect x="13" y="13" width="7" height="7" rx="2"></rect></svg></span>
<span style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; text-align: right"><span style="font-size: 14px; white-space: nowrap">همه‌ی قیمت‌ها</span><span style="font-size: 12px; color: #6B7280; font-weight: 400">@ViewFormat.Digits(total.ToString()) شکار امروز</span></span>
<span class="zchev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 6l-6 6 6 6"></path></svg></span>
</a>
</div>

@foreach (var cat in Model.Categories)
{
    var on = Model.List.Category == cat.Category;
    <div style="display: flex; gap: 6px; align-items: center">
    <a href="/hunts?category=@cat.Category" class="zcat@(on ? " zcat-on" : "")" aria-pressed="@(on ? "true" : "false")">
    <span class="zthumb"><img src="~/assets/categories/@cat.ImageFileName" alt="" style="width: 100%; height: 100%; object-fit: contain"></span>
    <span style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; text-align: right"><span style="font-size: 14px; white-space: nowrap">@cat.Label</span><span style="font-size: 12px; color: #6B7280; font-weight: 400">@ViewFormat.Digits(cat.TodayCount.ToString()) شکار امروز</span></span>
    <span class="zchev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 6l-6 6 6 6"></path></svg></span>
    </a>
    <form method="post" action="/bells/toggle" style="margin: 0">
    <input type="hidden" name="category" value="@cat.Category" />
    <input type="hidden" name="returnUrl" value="/hunts@(on ? "?category=" + cat.Category : "")" />
    <button class="zbell@(cat.BellOn ? " zbell-on" : "")" aria-label="خبرم کن: @cat.Label" aria-pressed="@(cat.BellOn ? "true" : "false")" type="submit">
    @if (cat.BellOn)
    {
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="1.8" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path><path d="M10 20.5a2 2 0 004 0" fill="none"></path></svg>
    }
    else
    {
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path><path d="M10 20.5a2 2 0 004 0"></path></svg>
    }
    </button>
    </form>
    </div>
}
<p style="margin: 8px 6px 0; font-size: 12px; color: #6B7280; display: flex; gap: 6px; align-items: center"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path></svg>زنگوله رو بزن؛ تا ۲۴ ساعت هر شکار تازه‌ی اون دسته رو پیامک می‌کنیم.</p>
</aside>

<main style="flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap">
<h1 style="margin: 0; font-size: 32px; font-weight: 800">شکارها</h1>
<span style="display: inline-flex; align-items: center; gap: 8px; background: #E6F4F1; color: #0F766E; padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 600"><span class="zlive"></span>بروزرسانی در لحظه</span>
</div>
<div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; border-bottom: 1px solid #E5E7EB">
<div role="tablist" aria-label="بازه‌ی زمانی" style="display: flex; gap: 4px">
@{
    var days = new[] { (HuntDay.Today, "امروز"), (HuntDay.Yesterday, "دیروز"), (HuntDay.TwoDaysAgo, "۲ روز پیش") };
    var catQ = Model.List.Category is null ? "" : $"category={Model.List.Category}&";
}
@foreach (var (d, label) in days)
{
    <a role="tab" class="ztab@(Model.List.Day == d ? " ztab-on" : "")" aria-selected="@(Model.List.Day == d ? "true" : "false")" href="/hunts?@(catQ)day=@d&sort=@Model.List.Sort">@label</a>
}
</div>
<div role="group" aria-label="مرتب‌سازی" style="display: flex; gap: 8px; align-items: center; padding-bottom: 8px; flex-wrap: wrap">
<span style="font-size: 13px; color: #6B7280">مرتب‌سازی:</span>
@{
    var sorts = new[] { (HuntSortOrder.TopScore, "بیشترین امتیاز"), (HuntSortOrder.MostBelowMarket, "بیشترین زیر بازار"), (HuntSortOrder.Newest, "جدیدترین") };
}
@foreach (var (s, label) in sorts)
{
    <a class="zsort@(Model.List.Sort == s ? " zsort-on" : "")" aria-pressed="@(Model.List.Sort == s ? "true" : "false")" href="/hunts?@(catQ)day=@Model.List.Day&sort=@s">@label</a>
}
</div>
</div>
<span style="font-size: 13px; color: #6B7280">@ViewFormat.Digits(Model.List.ActiveCount.ToString()) شکار فعال در «@(Model.List.Category is null ? "همه‌ی قیمت‌ها" : Model.Categories.First(c => c.Category == Model.List.Category).Label)»</span>

<div style="position: relative">
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px">
@foreach (var card in Model.List.Cards)
{
    <partial name="_Card" model="card" />
}
</div>
</div>
</main>
</div>
</div>
