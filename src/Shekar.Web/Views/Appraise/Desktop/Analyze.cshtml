@{
    ViewData["Title"] = "در حال تحلیل";
}
@section head {
<meta http-equiv="refresh" content="4; url=/appraise/result">
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/analyze.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh">
<header style="position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid #EEF0F2">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 32px; min-height: 72px; display: flex; align-items: center; gap: 36px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827"><svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 22px">شکار</b></a>
<nav aria-label="منوی اصلی" style="display: flex; gap: 28px; flex: 1"><a href="/hunts" style="color: #374151; font-weight: 500">شکارها</a><a href="/appraise" aria-current="page" style="color: #0F766E; font-weight: 700">ارزیابی آگهی</a><a href="/plans" style="color: #374151; font-weight: 500">پلن‌ها</a><a href="/contact" style="color: #374151; font-weight: 500">تماس با ما</a></nav>
<a href="/account" aria-label="حساب کاربری" style="width: 44px; height: 44px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></a>
</div>
</header>

<main style="max-width: 1120px; margin: 0 auto; padding: 40px 24px 96px; display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; align-items: center; gap: 10px; background: #F6F8F8; border-radius: 14px; padding: 12px 16px; font-size: 14px; flex-wrap: wrap">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"></path></svg>
<span style="color: #6B7280">آگهی:</span><b>پژو ۲۰۷ دنده‌ای پانوراما ۱۴۰۲ · ۱٫۳۴ میلیارد</b>
<a href="/appraise" style="margin-right: auto; font-weight: 600; min-height: 32px; display: flex; align-items: center">تغییر لینک</a>
</div>

<div style="display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch">
<section aria-live="polite" aria-label="در حال تحلیل" style="flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap">
<div><span style="display: flex; align-items: center; gap: 8px; color: #0F766E; font-weight: 700; font-size: 14px"><span class="zlive"></span>هوش مصنوعی شکار داره کار می‌کنه</span><h1 style="margin: 6px 0 0; font-size: 30px; font-weight: 800">قیمت رو با بازار مقایسه می‌کنیم<span class="zdot1">.</span><span class="zdot2">.</span><span class="zdot3">.</span></h1></div>
<div style="text-align: left"><b style="font-size: 44px; line-height: 1; color: #0F766E">۵۸٪</b><div style="font-size: 13px; color: #6B7280; margin-top: 4px">حدود ۹ ثانیه مونده</div></div>
</div>
<div role="progressbar" aria-valuenow="58" aria-valuemin="0" aria-valuemax="100" aria-label="پیشرفت تحلیل" style="height: 8px; background: #E6F4F1; border-radius: 8px; overflow: hidden"><div class="zprog" style="height: 100%; width: 58%; background: #0F766E; border-radius: 8px;"></div></div>

<div style="position: relative; height: 330px; border-radius: 24px; background: #F6F8F8; overflow: hidden">
<div aria-hidden="true" style="position: absolute; left: -10%; right: -10%; bottom: -30px; height: 180px; background-image: linear-gradient(#DCE5E4 1px, transparent 1px), linear-gradient(90deg, #DCE5E4 1px, transparent 1px); background-size: 40px 40px; transform: perspective(460px) rotateX(62deg); transform-origin: bottom"></div>
<svg viewBox="0 0 420 200" role="img" aria-label="ماشین در حال اسکن" style="position: absolute; left: 10%; width: 80%; bottom: 46px">
<defs><linearGradient id="ab" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF"></stop><stop offset=".55" stop-color="#D9E1E2"></stop><stop offset="1" stop-color="#9FAEB1"></stop></linearGradient></defs>
<ellipse cx="212" cy="176" rx="196" ry="13" fill="#0F172A" opacity=".16"></ellipse>
<path d="M20 150 L27 122 Q34 104 68 99 L128 92 L174 58 Q187 49 208 49 L274 49 Q297 49 314 64 L348 94 L384 100 Q405 105 407 123 L409 146 Q409 156 398 156 L31 156 Q20 156 20 150 Z" fill="url(#ab)" stroke="#8A999C" stroke-width="1.6"></path>
<path d="M146 92 L181 62 Q188 57 197 57 L240 57 L240 92 Z" fill="#334155"></path><path d="M250 92 L250 57 L276 57 Q292 57 302 66 L329 92 Z" fill="#334155"></path>
<circle cx="102" cy="156" r="29" fill="#111827"></circle><circle cx="102" cy="156" r="14" fill="#9CA3AF"></circle><circle cx="332" cy="156" r="29" fill="#111827"></circle><circle cx="332" cy="156" r="14" fill="#9CA3AF"></circle>
</svg>
<div class="zbeam" aria-hidden="true"></div>
<span class="zmark" style="position: absolute; top: 58px; right: 22%; background: #FFFFFF; border-radius: 999px; padding: 6px 12px; font-size: 13px; font-weight: 700; box-shadow: 0 6px 16px rgba(17,24,39,.08); display: flex; gap: 6px; align-items: center"><span style="width: 8px; height: 8px; border-radius: 50%; background: #0F766E"></span>کارکرد: ۲۸ هزار</span>
<span class="zmark" style="position: absolute; top: 24px; left: 18%; background: #111827; color: #FFFFFF; border-radius: 999px; padding: 6px 12px; font-size: 13px; font-weight: 700; display: flex; gap: 6px; align-items: center"><span style="width: 8px; height: 8px; border-radius: 50%; background: #5EEAD4"></span>بازار: ۱٫۵۶ میلیارد</span>

<span style="position: absolute; bottom: 14px; right: 18px; font-size: 13px; color: #6B7280; display: flex; gap: 8px; align-items: center"><span class="zlive"></span>محاسبه‌ی قیمت منصفانه</span>
</div>

<div style="background: #E6F4F1; border-radius: 16px; padding: 14px 18px; display: flex; gap: 12px; align-items: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M9 18h6M10 21h4M12 3a6 6 0 00-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0012 3z"></path></svg><span style="font-size: 15px">نکته: سند و کارت ماشین رو با مشخصات آگهی چک کن.</span></div>
</section>

<aside style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<div class="zbox">
<b style="font-size: 17px">مراحل بررسی</b>
<ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px">

<li style="display: flex; gap: 12px; align-items: flex-start">
<span style="width: 28px; height: 28px; border-radius: 50%; background: #0F766E; display: grid; place-items: center; flex: none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span>

<div style="display: flex; flex-direction: column; gap: 2px"><b style="color: #111827">خوندن آگهی</b><span style="font-size: 13px; color: #6B7280">عنوان، قیمت، ۱۲ عکس و توضیحات</span></div>
</li>

<li style="display: flex; gap: 12px; align-items: flex-start">
<span style="width: 28px; height: 28px; border-radius: 50%; background: #0F766E; display: grid; place-items: center; flex: none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span>

<div style="display: flex; flex-direction: column; gap: 2px"><b style="color: #111827">پیدا کردن ماشین‌های مشابه</b><span style="font-size: 13px; color: #6B7280">۴۲ آگهی مشابه پیدا شد</span></div>
</li>

<li style="display: flex; gap: 12px; align-items: flex-start">

<svg class="zspin" width="28" height="28" viewBox="0 0 26 26" aria-hidden="true" style="flex: none"><circle cx="13" cy="13" r="10" fill="none" stroke="#E6F4F1" stroke-width="3"></circle><path d="M13 3a10 10 0 0110 10" fill="none" stroke="#0F766E" stroke-width="3" stroke-linecap="round"></path></svg>

<div style="display: flex; flex-direction: column; gap: 2px"><b style="color: #111827">مقایسه با قیمت بازار</b><span style="font-size: 13px; color: #6B7280">۹۲۲ قیمت مقایسه شد</span></div>
</li>

<li style="display: flex; gap: 12px; align-items: flex-start">

<span style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid #E5E7EB; flex: none"></span>
<div style="display: flex; flex-direction: column; gap: 2px"><b style="color: #6B7280">بررسی ریسک‌ها</b><span style="font-size: 13px; color: #6B7280">در صف</span></div>
</li>

<li style="display: flex; gap: 12px; align-items: flex-start">

<span style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid #E5E7EB; flex: none"></span>
<div style="display: flex; flex-direction: column; gap: 2px"><b style="color: #6B7280">امتیازدهی نهایی</b><span style="font-size: 13px; color: #6B7280">در صف</span></div>
</li>

</ol>
</div>
<div class="zbox" style="background: #111827; border-color: #111827; color: #E5E7EB; gap: 10px; min-height: 230px">
<span style="font-size: 13px; color: #6B7280; display: flex; gap: 8px; align-items: center"><span class="zlive" style="background: #5EEAD4"></span>یافته‌ها، همین الان</span>
<div class="zline" style="display: flex; gap: 8px; align-items: flex-start; font-size: 14px; line-height: 1.7"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="3" aria-hidden="true" style="flex: none; margin-top: 5px"><path d="M5 12l5 5 9-10"></path></svg>مدل: پژو ۲۰۷ دنده‌ای پانوراما ۱۴۰۲</div><div class="zline" style="display: flex; gap: 8px; align-items: flex-start; font-size: 14px; line-height: 1.7"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="3" aria-hidden="true" style="flex: none; margin-top: 5px"><path d="M5 12l5 5 9-10"></path></svg>قیمت آگهی: ۱٫۳۴ میلیارد تومان</div><div class="zline" style="display: flex; gap: 8px; align-items: flex-start; font-size: 14px; line-height: 1.7"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="3" aria-hidden="true" style="flex: none; margin-top: 5px"><path d="M5 12l5 5 9-10"></path></svg>کارکرد: ۲۸ هزار کیلومتر</div><div class="zline" style="display: flex; gap: 8px; align-items: flex-start; font-size: 14px; line-height: 1.7"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="3" aria-hidden="true" style="flex: none; margin-top: 5px"><path d="M5 12l5 5 9-10"></path></svg>۴۲ آگهی مشابه تو ۳۰ روز اخیر</div><div class="zline" style="display: flex; gap: 8px; align-items: flex-start; font-size: 14px; line-height: 1.7"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="3" aria-hidden="true" style="flex: none; margin-top: 5px"><path d="M5 12l5 5 9-10"></path></svg>میانه‌ی قیمت بازار: ۱٫۵۶ میلیارد</div>
</div>
</aside>
</div>

</main>
</div>
