@model AppraiseViewModel
@{
    ViewData["Title"] = "ارزیابی آگهی";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/appraise.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh; position: relative">
<header style="position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid #EEF0F2">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 32px; min-height: 72px; display: flex; align-items: center; gap: 36px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827"><svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 22px">شکار</b></a>
<nav aria-label="منوی اصلی" style="display: flex; gap: 28px; flex: 1"><a href="/hunts" style="color: #374151; font-weight: 500">شکارها</a><a href="/appraise" aria-current="page" style="color: #0F766E; font-weight: 700">ارزیابی آگهی</a><a href="/plans" style="color: #374151; font-weight: 500">پلن‌ها</a><a href="/contact" style="color: #374151; font-weight: 500">تماس با ما</a></nav>
<a href="/account" aria-label="حساب کاربری" style="width: 44px; height: 44px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></a>
</div>
</header>

<main style="max-width: 1180px; margin: 0 auto; padding: 56px 24px 96px; display: flex; flex-direction: column; gap: 72px">
<section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 48px; align-items: center">
<div style="display: flex; flex-direction: column; gap: 20px">
<span style="align-self: flex-start; background: #E6F4F1; color: #0F766E; font-weight: 700; font-size: 14px; padding: 6px 14px; border-radius: 999px">@(Model.Quota.IsSubscriber ? "با اشتراک، کارشناسی نامحدوده" : $"این ماه {ViewFormat.Digits(Model.Quota.Remaining.ToString())} کارشناسی رایگان داری")</span>
<h1 style="margin: 0; font-size: 40px; line-height: 1.35; font-weight: 800">لینک آگهی بده، ارزش خریدش رو بهت بگیم!</h1>
<p style="margin: 0; color: #6B7280; font-size: 18px; line-height: 1.8">تو حدود ۲۰ ثانیه می‌فهمی این ماشین می‌ارزه یا نه؛ با امتیاز، قیمت منصفانه و ریسک‌هاش.</p>

<div style="display: flex; flex-direction: column; gap: 10px">
<div style="background: #F6F8F8; border-radius: 16px; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap"><span style="display: flex; gap: 12px; align-items: center"><span style="display: flex; gap: 4px" aria-hidden="true"><span style="width: 22px; height: 8px; border-radius: 4px; background: #D1D5DB"></span><span style="width: 22px; height: 8px; border-radius: 4px; background: #0F766E"></span><span style="width: 22px; height: 8px; border-radius: 4px; background: #0F766E"></span></span><span><b>کارشناسی رایگان این ماه: @(Model.Quota.IsSubscriber ? "نامحدود" : $"{ViewFormat.Digits(Model.Quota.Remaining.ToString())} از ۳ مونده")</b></span></span><a href="/plans" style="font-weight: 700; min-height: 40px; display: flex; align-items: center">با اشتراک، نامحدود ←</a></div>

<label for="lk" style="font-weight: 700">لینک آگهی خودرو</label>
<div style="display: flex; gap: 10px; flex-wrap: wrap">
<div class="zfield">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="flex: none"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"></path></svg>
<input id="lk" name="AdUrl" form="apf" type="url" dir="ltr" placeholder="https://… لینک آگهی رو اینجا بچسبون" value="" aria-invalid="false" aria-describedby="lkh" required>
<button class="zpaste" type="button"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="8" y="3" width="8" height="4" rx="1"></rect><path d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-2"></path></svg>چسباندن</button>
</div>

<form id="apf" method="post" action="/appraise"></form>
@if (TempData["AppraiseError"] is string err)
{
    <span style="color: #DC2626; font-size: 13px">@err</span>
}
<button type="submit" form="apf" class="zbtn zbtn-p" style="border: 0; cursor: pointer; font-family: inherit">بررسی کن</button>
</div>

<span id="lkh" style="color: #6B7280; font-size: 14px">لینک رو از صفحه‌ی آگهی کپی کن (دکمه‌ی «اشتراک‌گذاری») و اینجا بچسبون.</span>

</div>

</div>

<div aria-label="نمونه‌ی جواب" style="background: #F6F8F8; border-radius: 28px; padding: 28px; display: flex; flex-direction: column; gap: 16px; position: relative">
<span style="position: absolute; top: 18px; left: 18px; font-size: 12px; color: #6B7280; background: #FFFFFF; padding: 4px 10px; border-radius: 999px">نمونه‌ی جواب</span>
<div style="background: #FFFFFF; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 12px 32px rgba(17,24,39,.06)">
<div style="display: flex; gap: 16px; align-items: center">
<span style="position: relative; display: inline-grid; place-items: center; flex: none; width: 84px; height: 84px"><svg width="84" height="84" viewBox="0 0 128 128" role="img" aria-label="امتیاز ۸۷ از ۱۰۰"><circle cx="64" cy="64" r="54" fill="none" stroke="#F3F4F6" stroke-width="12"></circle><circle cx="64" cy="64" r="54" fill="none" stroke="#D4A017" stroke-width="12" stroke-linecap="round" stroke-dasharray="295.2 339.3" transform="rotate(-90 64 64)"></circle></svg><b aria-hidden="true" style="position: absolute; font-size: 26px; font-weight: 800">۸۷</b></span>
<div style="display: flex; flex-direction: column; gap: 6px"><b>پژو ۲۰۷ پانوراما ۱۴۰۲</b><span style="align-self: flex-start; background: #D4A017; color: #111827; font-weight: 700; font-size: 13px; padding: 3px 12px; border-radius: 999px">فرصت طلایی</span></div>
</div>
<div style="padding-top: 26px; position: relative">
<div style="position: absolute; top: 0; left: 16%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center"><span style="background: #111827; color: #FFFFFF; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 8px; white-space: nowrap">۱۴٪ زیر بازار</span><span style="width: 2px; height: 10px; background: #111827"></span></div>
<div style="display: flex; height: 10px; border-radius: 999px; overflow: hidden; gap: 4px"><span style="flex: 1; background: #FCA5A5"></span><span style="flex: 1.2; background: #5EEAD4"></span><span style="flex: 1; background: #D4A017"></span></div>
<div style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 11px; color: #6B7280"><span>گران</span><span>منصفانه</span><span>فرصت طلایی</span></div>
</div>
<div style="display: flex; gap: 8px; flex-wrap: wrap"><span style="background: #FEF3C7; color: #92400E; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px">رنگ‌شدگی ذکر شده</span><span style="background: #E6F4F1; color: #0F766E; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px">بیمه‌ی معتبر</span></div>
</div>
</div>
</section>

<section aria-labelledby="what" style="display: flex; flex-direction: column; gap: 24px">
<h2 id="what" style="margin: 0; font-size: 28px; font-weight: 800">چی بهت می‌گیم؟</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px">
<div style="border: 1px solid #E5E7EB; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 10px">
<span style="width: 48px; height: 48px; border-radius: 14px; background: #E6F4F1; display: grid; place-items: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 12l4-3"></path></svg></span>
<b style="font-size: 18px">امتیاز ۰ تا ۱۰۰</b><span style="color: #6B7280; line-height: 1.8">یه عدد ساده که می‌گه این ماشین چقدر ارزش خرید داره.</span>
</div>
<div style="border: 1px solid #E5E7EB; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 10px">
<span style="width: 48px; height: 48px; border-radius: 14px; background: #E6F4F1; display: grid; place-items: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg></span>
<b style="font-size: 18px">قیمت منصفانه</b><span style="color: #6B7280; line-height: 1.8">قیمت واقعی بازار رو می‌گیم و اینکه این آگهی گرونه یا ارزون.</span>
</div>
<div style="border: 1px solid #E5E7EB; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 10px">
<span style="width: 48px; height: 48px; border-radius: 14px; background: #FEF3C7; display: grid; place-items: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#92400E" stroke-width="2" aria-hidden="true"><path d="M12 3l9 16H3z"></path><path d="M12 10v4M12 17h.01"></path></svg></span>
<b style="font-size: 18px">ریسک‌های پنهان</b><span style="color: #6B7280; line-height: 1.8">نکته‌های مشکوک توی توضیحات و عکس‌ها رو برات پیدا می‌کنیم.</span>
</div>
</div>
</section>

<section aria-labelledby="how" style="background: #F6F8F8; border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 24px">
<h2 id="how" style="margin: 0; font-size: 28px; font-weight: 800">چطوری؟ فقط ۳ قدم</h2>
<ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px">
<li style="display: flex; gap: 14px; align-items: flex-start"><span style="width: 40px; height: 40px; border-radius: 50%; background: #0F766E; color: #FFFFFF; display: grid; place-items: center; font-weight: 800; flex: none">۱</span><div><b style="display: block">لینک آگهی رو کپی کن</b><span style="color: #6B7280; font-size: 14px">از صفحه‌ی آگهی، دکمه‌ی اشتراک‌گذاری.</span></div></li>
<li style="display: flex; gap: 14px; align-items: flex-start"><span style="width: 40px; height: 40px; border-radius: 50%; background: #0F766E; color: #FFFFFF; display: grid; place-items: center; font-weight: 800; flex: none">۲</span><div><b style="display: block">اینجا بچسبون</b><span style="color: #6B7280; font-size: 14px">و «بررسی کن» رو بزن.</span></div></li>
<li style="display: flex; gap: 14px; align-items: flex-start"><span style="width: 40px; height: 40px; border-radius: 50%; background: #0F766E; color: #FFFFFF; display: grid; place-items: center; font-weight: 800; flex: none">۳</span><div><b style="display: block">حدود ۲۰ ثانیه صبر کن</b><span style="color: #6B7280; font-size: 14px">جوابت کامل و آماده‌ست.</span></div></li>
</ol>
</section>
<p style="margin: -40px 0 0; font-size: 13px; color: #6B7280; text-align: center">فعلاً فقط آگهی‌های خودرو · قیمت و سود تخمینیه و تضمینی نیست؛ قبل از خرید حتماً کارشناسی کن.</p>
</main>

</div>
