@{
    ViewData["Title"] = "ارزیابی آگهی";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/appraise-quota-exhausted.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; display: flex; flex-direction: column; position: relative">
<main style="padding: 20px 16px 28px; display: flex; flex-direction: column; gap: 20px; flex: 1">
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="align-self: flex-start; background: #FEF3C7; color: #92400E; font-weight: 700; font-size: 12px; padding: 5px 12px; border-radius: 999px">سهمیه‌ی رایگان این ماه تموم شد</span>
<h1 style="margin: 0; font-size: 24px; font-weight: 800; line-height: 1.5">لینک آگهی بده، ارزش خریدش رو بهت بگیم!</h1>
<p style="margin: 0; color: #6B7280; font-size: 14px; line-height: 1.8">تو حدود ۲۰ ثانیه می‌فهمی این ماشین می‌ارزه یا نه.</p>
</div>

<div style="display: flex; flex-direction: column; gap: 10px">

<div style="border: 1.5px solid #F1DFA6; background: #FFFBEB; border-radius: 20px; padding: 18px; display: flex; flex-direction: column; gap: 12px; text-align: center; align-items: center">
<span style="width: 52px; height: 52px; border-radius: 50%; background: #FEF3C7; display: grid; place-items: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#92400E" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 018 0v4"></path></svg></span>
<b style="font-size: 17px">سهمیه‌ی رایگان این ماه تموم شد</b>
<span style="color: #6B7280; font-size: 13px; line-height: 1.8">هر ۳ کارشناسی رایگانت رو استفاده کردی. اول آذر دوباره ۳ تا هدیه می‌گیری.</span>
<div style="display: flex; gap: 4px; width: 100%" aria-hidden="true"><span style="flex: 1; height: 6px; border-radius: 4px; background: #D97706"></span><span style="flex: 1; height: 6px; border-radius: 4px; background: #D97706"></span><span style="flex: 1; height: 6px; border-radius: 4px; background: #D97706"></span></div>
<a href="/plans" class="zbtn zbtn-p" style="width: 100%">۲۴ ساعت رایگان امتحان کن</a>
<span style="font-size: 12px; color: #6B7280">با اشتراک، کارشناسی نامحدوده.</span>
</div>

</div>

<section aria-labelledby="what" style="display: flex; flex-direction: column; gap: 10px">
<h2 id="what" style="margin: 0; font-size: 18px; font-weight: 800">چی بهت می‌گیم؟</h2>
<div style="display: flex; gap: 12px; align-items: center; border: 1px solid #E5E7EB; border-radius: 16px; padding: 14px"><span style="width: 42px; height: 42px; border-radius: 12px; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 12l4-3"></path></svg></span><div><b style="display: block">امتیاز ۰ تا ۱۰۰</b><span style="font-size: 13px; color: #6B7280">چقدر ارزش خرید داره، با یه عدد ساده.</span></div></div>
<div style="display: flex; gap: 12px; align-items: center; border: 1px solid #E5E7EB; border-radius: 16px; padding: 14px"><span style="width: 42px; height: 42px; border-radius: 12px; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg></span><div><b style="display: block">قیمت منصفانه</b><span style="font-size: 13px; color: #6B7280">گرونه یا ارزون؟ با قیمت واقعی بازار.</span></div></div>
<div style="display: flex; gap: 12px; align-items: center; border: 1px solid #E5E7EB; border-radius: 16px; padding: 14px"><span style="width: 42px; height: 42px; border-radius: 12px; background: #FEF3C7; display: grid; place-items: center; flex: none"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#92400E" stroke-width="2" aria-hidden="true"><path d="M12 3l9 16H3z"></path><path d="M12 10v4M12 17h.01"></path></svg></span><div><b style="display: block">ریسک‌های پنهان</b><span style="font-size: 13px; color: #6B7280">نکته‌های مشکوک توضیحات و عکس‌ها.</span></div></div>
</section>

<section aria-label="نمونه‌ی جواب" style="background: #F6F8F8; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 12px">
<span style="font-size: 12px; color: #6B7280">نمونه‌ی جواب</span>
<div style="background: #FFFFFF; border-radius: 16px; padding: 14px; display: flex; gap: 14px; align-items: center">
<span style="position: relative; display: inline-grid; place-items: center; flex: none; width: 64px; height: 64px"><svg width="64" height="64" viewBox="0 0 128 128" role="img" aria-label="امتیاز ۸۷"><circle cx="64" cy="64" r="54" fill="none" stroke="#F3F4F6" stroke-width="12"></circle><circle cx="64" cy="64" r="54" fill="none" stroke="#D4A017" stroke-width="12" stroke-linecap="round" stroke-dasharray="295.2 339.3" transform="rotate(-90 64 64)"></circle></svg><b aria-hidden="true" style="position: absolute; font-size: 21px; font-weight: 800">۸۷</b></span>
<div style="display: flex; flex-direction: column; gap: 6px"><b style="font-size: 14px">پژو ۲۰۷ پانوراما ۱۴۰۲</b><span style="align-self: flex-start; background: #D4A017; color: #111827; font-weight: 700; font-size: 12px; padding: 2px 10px; border-radius: 999px">فرصت طلایی · ۱۴٪ زیر بازار</span></div>
</div>
</section>
<p style="margin: 0; font-size: 12px; color: #6B7280; text-align: center">فعلاً فقط آگهی‌های خودرو · قیمت‌ها تخمینیه و تضمینی نیست.</p>
</main>

<nav aria-label="منوی پایین" style="position: sticky; bottom: 0; background: #FFFFFF; border-top: 1px solid #EEF0F2; display: flex; padding: 4px 8px 14px; z-index: 5">
<a href="/categories" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg>شکارها</a>
<a href="/appraise" class="znav znav-on" aria-current="page"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg>کارشناسی</a>
<a href="/plans" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 10h18"></path></svg>پلن‌ها</a>
<a href="/account" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>حساب</a>
</nav>

</div>
