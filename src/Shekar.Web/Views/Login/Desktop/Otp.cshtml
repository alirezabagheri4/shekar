@model LoginOtpViewModel
@{
    ViewData["Title"] = "ورود";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/login-otp.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh; display: flex; flex-wrap: wrap">

<section style="flex: 1 1 520px; min-width: 0; display: flex; align-items: center; justify-content: center; padding: 48px 24px">
<div style="width: 100%; max-width: 420px; display: flex; flex-direction: column; gap: 28px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827">
<svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#FFFFFF" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg>
<span style="font-weight: 800; font-size: 22px">شکار</span>
</a>
<div style="display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 13px; color: #6B7280">مرحله ۲ از ۳</span>
<div style="display: flex; gap: 6px"><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #E5E7EB"></span></div>
</div>

<div style="display: flex; flex-direction: column; gap: 20px">
<div><h1 style="margin: 0 0 6px; font-size: 28px; font-weight: 800">کد رو وارد کن</h1><p style="margin: 0; color: #6B7280">یه کد ۵ رقمی به <b dir="ltr" style="color: #111827">@ViewFormat.Digits(Model.Mobile)</b> فرستادیم.</p>
<a class="zlink" href="/login?returnUrl=@ViewData["ReturnUrl"]">شماره رو اشتباه زدی؟ ویرایش کن</a></div>
<form method="post" action="/login/otp" style="display: flex; flex-direction: column; gap: 20px">
<input type="hidden" name="mobile" value="@Model.Mobile" />
<input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
<fieldset style="border: 0; padding: 0; margin: 0">
<legend style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">کد یک‌بارمصرف</legend>
<div dir="ltr" style="display: flex; gap: 10px; justify-content: space-between">
<input class="zotp" name="d1" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="رقم ۱" value="" required><input class="zotp" name="d2" type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۲" value="" required><input class="zotp" name="d3" type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۳" value="" required><input class="zotp" name="d4" type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۴" value="" required><input class="zotp" name="d5" type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۵" value="" required>
</div>
</fieldset>
<span asp-validation-summary="All" style="color: #DC2626; font-size: 13px; text-align: center"></span>
<button type="submit" class="zbtn zbtn-p" style="border: 0; cursor: pointer; font-family: inherit">تأیید و ادامه</button>
<div style="display: flex; justify-content: center; font-size: 14px; color: #6B7280">
<span>کد تستی: <b dir="ltr" style="color: #111827">۱۲۳۴۵</b></span>
</div>
</form>
@section scripts {
<script>
(function(){var norm=function(s){return s.replace(/[۰-۹]/g,function(c){return c.charCodeAt(0)-0x06F0;}).replace(/[٠-٩]/g,function(c){return c.charCodeAt(0)-0x0660;});};var b=document.querySelectorAll('.zotp');var form=b.length&&b[0].form;b.forEach(function(el,i){el.addEventListener('input',function(){el.value=norm(el.value);if(el.value.length>=1){if(i<b.length-1){b[i+1].focus();}else{var ok=Array.from(b).every(function(x){return x.value.length===1;});if(ok&&form){form.requestSubmit?form.requestSubmit():form.submit();}}}});el.addEventListener('keydown',function(e){if(e.key==='Backspace'&&!el.value&&i>0)b[i-1].focus();});});if(b[0])b[0].focus();})();
</script>
}
</div>

</div>
</section>

<aside aria-hidden="true" style="flex: 1 1 520px; min-width: 0; min-height: 420px; background: #EEF5F3; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; padding: 56px 48px 48px; color: #111827">
<div style="position: relative; display: flex; flex-direction: column; gap: 10px">
<span style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: #0F766E; font-weight: 600"><span class="zlive" style="background: #0F766E"></span>همین الان در حال اسکن</span>
<b style="font-size: 32px; line-height: 1.4">ماشین زیر قیمت رو قبل از همه شکار کن</b>
</div>
<div style="position: relative; flex: 1; display: flex; align-items: center">
<img src="~/assets/brand/signup-sedan.webp" alt="" style="display: block; width: 100%; height: auto; mix-blend-mode: multiply">

</div>
<div style="position: relative; display: flex; gap: 10px; flex-wrap: wrap">
<span style="background: #FFFFFF; border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 700">امتیاز ۰ تا ۱۰۰</span>
<span style="background: #FFFFFF; border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 700">قیمت منصفانه</span>
<span style="background: #D4A017; border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 700">فرصت طلایی</span>
</div>
</aside>
</div>
