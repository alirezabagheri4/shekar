@model LoginOtpViewModel
@{
    ViewData["Title"] = "ورود";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/login-otp.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; display: flex; flex-direction: column; padding: 16px 16px 24px; gap: 20px">
<div style="display: flex; align-items: center; justify-content: space-between">
<a href="/" aria-label="بازگشت" style="width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #F6F8F8"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
<span style="font-size: 13px; color: #6B7280">مرحله ۲ از ۳</span>
</div>
<div style="display: flex; gap: 6px"><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #E5E7EB"></span></div>
<div aria-hidden="true" style="height: 140px; border-radius: 20px; background: #EEF5F3; position: relative; overflow: hidden; display: grid; place-items: center; padding: 0 12px">
<img src="~/assets/brand/signup-sedan.webp" alt="" style="display: block; width: 100%; height: auto; mix-blend-mode: multiply">

</div>

<div style="display: flex; flex-direction: column; gap: 16px; flex: 1">
<div><h1 style="margin: 0 0 4px; font-size: 24px; font-weight: 800">کد رو وارد کن</h1><p style="margin: 0; color: #6B7280">یه کد ۵ رقمی به <b dir="ltr" style="color: #111827">@ViewFormat.Digits(Model.Mobile)</b> فرستادیم.</p><a class="zlink" href="/login?returnUrl=@ViewData["ReturnUrl"]">شماره رو اشتباه زدی؟ ویرایش کن</a></div>
<form method="post" action="/login/otp" style="display: flex; flex-direction: column; gap: 16px; flex: 1">
<input type="hidden" name="mobile" value="@Model.Mobile" />
<input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
<fieldset style="border: 0; padding: 0; margin: 0"><legend style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">کد یک‌بارمصرف</legend>
<div dir="ltr" style="display: flex; justify-content: space-between">
<input class="zotp" name="d1" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="رقم ۱" value="" required><input class="zotp" name="d2" type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۲" value="" required><input class="zotp" name="d3" type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۳" value="" required><input class="zotp" name="d4" type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۴" value="" required><input class="zotp" name="d5" type="text" inputmode="numeric" maxlength="1" aria-label="رقم ۵" value="" required>
</div></fieldset>
<span asp-validation-summary="All" style="color: #DC2626; font-size: 13px; text-align: center"></span>
<div style="display: flex; justify-content: center; font-size: 14px; color: #6B7280">
<span>کد تستی: <b dir="ltr" style="color: #111827">۱۲۳۴۵</b></span>
</div>
<div style="margin-top: auto">
<button type="submit" class="zbtn zbtn-p" style="width: 100%; border: 0; cursor: pointer; font-family: inherit">تأیید و ادامه</button>
</div>
</form>
</div>
@section scripts {
<script>
(function(){var norm=function(s){return s.replace(/[۰-۹]/g,function(c){return c.charCodeAt(0)-0x06F0;}).replace(/[٠-٩]/g,function(c){return c.charCodeAt(0)-0x0660;});};var b=document.querySelectorAll('.zotp');var form=b.length&&b[0].form;b.forEach(function(el,i){el.addEventListener('input',function(){el.value=norm(el.value);if(el.value.length>=1){if(i<b.length-1){b[i+1].focus();}else{var ok=Array.from(b).every(function(x){return x.value.length===1;});if(ok&&form){form.requestSubmit?form.requestSubmit():form.submit();}}}});el.addEventListener('keydown',function(e){if(e.key==='Backspace'&&!el.value&&i>0)b[i-1].focus();});});if(b[0])b[0].focus();})();
</script>
}

</div>
