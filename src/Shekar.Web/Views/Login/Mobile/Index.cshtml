@{
    ViewData["Title"] = "ورود";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/login.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; display: flex; flex-direction: column; padding: 16px 16px 24px; gap: 20px">
<div style="display: flex; align-items: center; justify-content: space-between">
<a href="/" aria-label="بازگشت" style="width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #F6F8F8"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
<span style="font-size: 13px; color: #6B7280">مرحله ۱ از ۳</span>
</div>
<div style="display: flex; gap: 6px"><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #E5E7EB"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #E5E7EB"></span></div>
<div aria-hidden="true" style="height: 140px; border-radius: 20px; background: #EEF5F3; position: relative; overflow: hidden; display: grid; place-items: center; padding: 0 12px">
<img src="~/assets/brand/signup-sedan.webp" alt="" style="display: block; width: 100%; height: auto; mix-blend-mode: multiply">

</div>

<div style="display: flex; flex-direction: column; gap: 16px; flex: 1">
<div><h1 style="margin: 0 0 4px; font-size: 24px; font-weight: 800">سلام! خوش اومدی</h1><p style="margin: 0; color: #6B7280">شماره موبایلت رو بزن، یه کد برات می‌فرستیم.</p></div>
<form method="post" action="/login" style="display: flex; flex-direction: column; gap: 16px; flex: 1">
<input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
<div style="display: flex; flex-direction: column; gap: 8px">
<label for="ph" style="font-weight: 600; font-size: 14px">شماره موبایل</label>
<input id="ph" name="Mobile" class="zin" type="tel" inputmode="numeric" dir="ltr" placeholder="09xxxxxxxxx" value="" style="text-align: left" required oninput="this.value=this.value.replace(/[۰-۹]/g,function(c){return c.charCodeAt(0)-0x06F0;}).replace(/[٠-٩]/g,function(c){return c.charCodeAt(0)-0x0660;})">
<span asp-validation-summary="All" style="color: #DC2626; font-size: 12px"></span>
</div>
<div style="margin-top: auto; display: flex; flex-direction: column; gap: 10px"><button type="submit" class="zbtn zbtn-p" style="border: 0; cursor: pointer; font-family: inherit">کد رو بفرست</button><p style="margin: 0; font-size: 12px; color: #6B7280; text-align: center">ورود یعنی پذیرش <a href="#">قوانین شکار</a>.</p></div>
</form>
</div>

</div>
