@model PayReviewViewModel
@{
    ViewData["Title"] = "بررسی واریزی";
    bool isPro = Model.Plan != "basic";
    string planName = isPro ? "شکارچی حرفه‌ای" : "شکارچی";
    string price = isPro ? "۱,۴۹۹,۰۰۰" : "۹۹۰,۰۰۰";
    string validUntil = string.IsNullOrEmpty(Model.ExpiresLabel) ? "—" : Model.ExpiresLabel;
}
@section css {
<link rel="stylesheet" href="~/css/mobile/payment.css">
}
<div class="app" style="background: radial-gradient(420px 300px at 50% 0%, rgba(94,234,212,.18), transparent 70%), #F6F8F8" data-review-page data-duration="15000">
<header class="mhdr" style="background: transparent; border: 0"><span style="display: flex; align-items: center; gap: 8px; flex: 1"><svg width="30" height="30" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 18px">شکار</b></span><span class="muted" style="font-size: 12px" data-stage-label>مرحله ۳ از ۳</span></header>
<main class="wrap">
<section aria-live="polite" aria-label="در حال بررسی واریزی" data-review style="display: flex; flex-direction: column; gap: 14px; width: 100%">
<div style="display: flex; align-items: center; gap: 14px">
<div class="orb" style="width: 64px; height: 64px; flex: none"><span style="position: relative; z-index: 1; width: 100%; height: 100%; border-radius: 50%; background: linear-gradient(135deg, #0F766E, #134E4A); display: grid; place-items: center"><svg width="30" height="30" viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg></span></div>
<div style="flex: 1; display: flex; flex-direction: column; gap: 4px"><span style="color: var(--teal); font-weight: 700; font-size: 13px">بررسی خودکار · مرحله <span data-stepno>۱</span> از ۵</span><h1 style="font-size: 19px; font-weight: 800">در حال بررسی واریزی شما</h1><p class="muted" style="font-size: 13px"><span data-headline>رسیدت رسید؛ داریم آماده‌ش می‌کنیم</span>…</p></div>
<div style="text-align: center; flex: none"><b data-pct style="display: block; font-size: 26px; color: var(--teal); line-height: 1.1">۰٪</b><span class="muted" style="font-size: 12px"><span data-left>۱۵</span> ثانیه</span></div>
</div>
<div class="prog" role="progressbar" aria-label="پیشرفت بررسی" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-prog><b style="width: 0%" data-bar></b></div>
<div class="rimg" style="height: 236px" aria-label="رسید در حال اسکن">
<img data-receipt-img alt="رسید ارسال‌شده" hidden>
<div data-receipt-mock style="position: absolute; inset: 0; padding: 18px; display: flex; flex-direction: column; gap: 8px; font-size: 12px; color: var(--muted)">
<div style="display: flex; justify-content: space-between; align-items: center"><b style="color: var(--ink); font-size: 13px">رسید انتقال کارت به کارت</b><span style="width: 22px; height: 22px; border-radius: 50%; background: var(--teal-50)"></span></div>
<div style="height: 1px; background: var(--line-2)"></div>
<div class="mrow" data-hl="amount"><span>مبلغ</span><b style="color: var(--ink)"><span data-price>@price</span> تومان</b></div><div class="mrow" data-hl="card"><span>کارت مقصد</span><b style="color: var(--ink)" dir=ltr>۶۲۱۹ •••• ۸۳۷۲</b></div><div class="mrow" data-hl="date"><span>تاریخ</span><b style="color: var(--ink)">۱۴۰۵/۰۸/۱۲ · ۱۴:۲۲</b></div><div class="mrow" data-hl="trace"><span>شماره پیگیری</span><b style="color: var(--ink)">۴۸۲۱۹۳</b></div>
<div style="margin-top: auto; text-align: center; color: var(--teal); font-weight: 700">تراکنش موفق</div>
</div>
<div class="grid" aria-hidden="true"></div>
<div class="scan" data-scan></div>
<span style="position: absolute; top: 10px; left: 10px; background: rgba(11,18,32,.78); color: #5EEAD4; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; direction: ltr">AI · OCR</span>
</div><div class="box" style="padding: 16px"><div style="display: flex; flex-direction: column; gap: 8px"><b style="font-size: 14px">اطلاعات خونده‌شده از رسید</b><div class="fld" data-field="amount"><span class="muted">مبلغ واریزی</span><span class="val"><span class="skel" data-skel></span><b data-val hidden><span data-price>@price</span> تومان</b><span data-val hidden style="color: var(--teal)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span></span></div><div class="fld" data-field="card"><span class="muted">کارت مقصد</span><span class="val"><span class="skel" data-skel></span><b data-val hidden>۶۲۱۹ •••• ۸۳۷۲</b><span data-val hidden style="color: var(--teal)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span></span></div><div class="fld" data-field="date"><span class="muted">تاریخ واریز</span><span class="val"><span class="skel" data-skel></span><b data-val hidden>۱۲ آبان ۱۴۰۵ · ۱۴:۲۲</b><span data-val hidden style="color: var(--teal)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span></span></div><div class="fld" data-field="trace"><span class="muted">شماره پیگیری</span><span class="val"><span class="skel" data-skel></span><b data-val hidden>۴۸۲۱۹۳</b><span data-val hidden style="color: var(--teal)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span></span></div></div></div><div class="box" style="padding: 16px"><ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 13px"><li class="chk chk-wait" data-step="0"><i><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></i>دریافت و آماده‌سازی رسید</li><li class="chk chk-wait" data-step="1"><i><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></i>استخراج اطلاعات از رسید</li><li class="chk chk-wait" data-step="2"><i><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></i>تطبیق مبلغ و کارت مقصد</li><li class="chk chk-wait" data-step="3"><i><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></i>استعلام شماره پیگیری</li><li class="chk chk-wait" data-step="4"><i><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></i>فعال‌سازی اشتراک</li></ul></div><div class="term" aria-label="لاگ سیستم" style="min-height: 170px"><div class="dim" style="margin-bottom: 4px">shekar-verify · payment #<span data-ref>@Model.Reference</span></div><div data-log></div><span class="cursor"></span></div>
<p class="muted" style="font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 6px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>این صفحه رو نبند؛ بررسی خودکاره و تا چند ثانیه‌ی دیگه تموم می‌شه.</p>
</section>
<section aria-live="polite" aria-labelledby="ok" class="fade" data-done hidden style="position: relative; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; width: 100%; max-width: 520px; margin: 8px auto 0">
<div style="position: absolute; inset: 0 0 auto 0; height: 180px; pointer-events: none" aria-hidden="true"><span class="conf" style="top: 0; left: 12%; background: #0F766E; animation-delay: 0s"></span><span class="conf" style="top: 0; left: 24%; background: #D4A017; animation-delay: 0.15s"></span><span class="conf" style="top: 0; left: 38%; background: #5EEAD4; animation-delay: 0.05s"></span><span class="conf" style="top: 0; left: 52%; background: #0F766E; animation-delay: 0.25s"></span><span class="conf" style="top: 0; left: 66%; background: #D4A017; animation-delay: 0.1s"></span><span class="conf" style="top: 0; left: 80%; background: #5EEAD4; animation-delay: 0.3s"></span><span class="conf" style="top: 0; left: 90%; background: #0F766E; animation-delay: 0.2s"></span></div>
<span class="pop" style="width: 96px; height: 96px; border-radius: 50%; background: var(--teal); display: grid; place-items: center; box-shadow: 0 16px 40px rgba(15,118,110,.35)"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span>
<div style="display: flex; flex-direction: column; gap: 6px"><h1 id="ok" style="font-size: 26px; font-weight: 800">تبریک! اشتراکت فعال شد</h1><p class="muted" style="font-size: 15px">واریزی‌ت ثبت شد و اشتراکت فعال شد. بررسی نهایی رسید توسط تیم ما انجام می‌شه.</p></div>
<dl class="box" style="margin: 0; width: 100%; padding: 6px 20px; text-align: right">
<div class="sumrow"><dt class="muted">پلن فعال</dt><dd style="margin: 0; font-weight: 800; color: var(--teal)"><span data-plan-name>@planName</span></dd></div>
<div class="sumrow"><dt class="muted">مبلغ</dt><dd style="margin: 0; font-weight: 700"><span data-price>@price</span> تومان</dd></div>
<div class="sumrow"><dt class="muted">اعتبار تا</dt><dd style="margin: 0; font-weight: 700" data-valid-until>@validUntil</dd></div>
<div class="sumrow" style="border: 0"><dt class="muted">کد پیگیری</dt><dd dir="ltr" style="margin: 0; font-weight: 700" data-ref>@Model.Reference</dd></div>
</dl>
<div data-pro-only><div style="width: 100%; display: flex; gap: 10px; align-items: center; background: var(--teal-50); border-radius: 14px; padding: 12px 14px; font-size: 13px; text-align: right"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg><span>زنگوله‌ی «خبرم کن» هر دسته هم برات فعال شد.</span></div></div>
<a href="/hunts" class="btn btn-p" style="width: 100%; min-height: 56px; font-size: 17px">بریم سراغ شکارها</a>
<a href="/account" style="font-weight: 700; font-size: 14px">دیدن حساب کاربری</a>
</section>
</main>
</div>
@section scripts {
<script src="~/js/payment.js" defer></script>
}
