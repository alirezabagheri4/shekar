@{
    ViewData["Title"] = "تماس با ما";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/contact.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh">
<header style="position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid #EEF0F2">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 32px; min-height: 72px; display: flex; align-items: center; gap: 36px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827"><svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 22px">شکار</b></a>
<nav aria-label="منوی اصلی" style="display: flex; gap: 28px; flex: 1"><a href="/hunts" style="color: #374151; font-weight: 500">شکارها</a><a href="/appraise" style="color: #374151; font-weight: 500">ارزیابی آگهی</a><a href="/plans" style="color: #374151; font-weight: 500">پلن‌ها</a><a href="/contact" aria-current="page" style="color: #0F766E; font-weight: 700">تماس با ما</a></nav>
<a href="/account" aria-label="حساب کاربری" style="width: 44px; height: 44px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></a>
</div>
</header>

<main style="max-width: 1180px; margin: 0 auto; padding: 48px 24px 96px; display: flex; flex-direction: column; gap: 32px">
<section style="background: #0F766E; border-radius: 28px; padding: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 40px; align-items: center; color: #FFFFFF; position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; left: -80px; top: -80px; width: 320px; height: 320px; border-radius: 50%; border: 40px solid rgba(255,255,255,.06)"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px">
<span role="status" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,.14); padding: 7px 14px; border-radius: 999px; font-size: 14px; font-weight: 600">
<span class="zlive" style="background: #5EEAD4"></span>

الان آنلاینیم؛ پیام بده!</span>
<h1 style="margin: 0; font-size: 44px; font-weight: 800; line-height: 1.3">سلام! ما اینجاییم</h1>
<p style="margin: 0; font-size: 18px; color: #CDEBE5; line-height: 1.8">سؤال داری یا یه آگهی برات مشکوکه؟ یه پیام بده، کنارتیم.</p>
<div style="background: rgba(255,255,255,.12); border-radius: 20px; padding: 10px 10px 10px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap">
<div style="display: flex; flex-direction: column"><span style="font-size: 13px; color: #CDEBE5">همه‌جا با یه آیدی</span><b dir="ltr" style="font-size: 28px; letter-spacing: .5px; text-align: right">@@shekarai</b></div>
<button class="zcopy"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 012-2h10"></path></svg>کپی آیدی</button>
</div>
</div>
<div aria-hidden="true" class="zfloat" style="position: relative; background: #FFFFFF; border-radius: 28px; padding: 22px; display: flex; flex-direction: column; gap: 12px; color: #111827; box-shadow: 0 24px 60px rgba(0,0,0,.18); max-width: 440px; justify-self: center; width: 100%">
<div style="display: flex; align-items: center; gap: 10px; padding-bottom: 12px; border-bottom: 1px solid #EEF0F2"><svg width="38" height="38" viewBox="0 0 36 36"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#FFFFFF" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><div><b style="display: block">پشتیبانی شکار</b><span style="font-size: 12px; color: #0F766E">@@shekarai</span></div></div>
<div class="zb1" style="align-self: flex-start; background: #F3F4F6; border-radius: 16px 16px 16px 4px; padding: 10px 14px; font-size: 14px; max-width: 80%">سلام، این پژو ۲۰۷ واقعاً می‌ارزه؟</div>
<div class="zb2" style="align-self: flex-end; background: #0F766E; color: #FFFFFF; border-radius: 16px 16px 4px 16px; padding: 10px 14px; font-size: 14px; max-width: 85%; line-height: 1.8">سلام! لینکش رو بفرست؛ تو ۲۰ ثانیه امتیاز و قیمت منصفانه‌ش رو می‌گیم.</div>
<div class="zb3" style="align-self: flex-start; background: #F3F4F6; border-radius: 16px; padding: 12px 14px; display: flex; gap: 4px"><span class="zd"></span><span class="zd"></span><span class="zd"></span></div>
</div>
</section>

<section aria-label="راه‌های ارتباطی" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px">

<div class="zch">
<div style="display: flex; align-items: center; justify-content: space-between">
<span style="width: 60px; height: 60px; border-radius: 20px; background: #0F766E; display: grid; place-items: center">
<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M21 4L3 11l6 2.5L19 7l-8 8 .5 5 3-3.5L19 20z"></path></svg>

</span>
<span style="font-size: 12px; font-weight: 700; color: #0F766E; background: #E6F4F1; padding: 4px 10px; border-radius: 999px">سریع‌ترین</span>
</div>
<div><b style="font-size: 22px; display: block">تلگرام</b><span style="color: #6B7280; font-size: 14px">سریع‌ترین راه برای جواب گرفتن</span></div>
<b dir="ltr" style="font-size: 18px; color: #0F766E; text-align: right">@@shekarai</b>
<a href="#" class="zbtn zbtn-p">پیام بده در تلگرام<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
</div>

<div class="zch">
<div style="display: flex; align-items: center; justify-content: space-between">
<span style="width: 60px; height: 60px; border-radius: 20px; background: #134E4A; display: grid; place-items: center">

<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path><path d="M8 10h8M8 13h5" stroke-linecap="round"></path></svg>

</span>
<span style="font-size: 12px; font-weight: 700; color: #0F766E; background: #E6F4F1; padding: 4px 10px; border-radius: 999px">پیام‌رسان ایرانی</span>
</div>
<div><b style="font-size: 22px; display: block">بله</b><span style="color: #6B7280; font-size: 14px">اگه بله داری، اینجا هم هستیم</span></div>
<b dir="ltr" style="font-size: 18px; color: #0F766E; text-align: right">@@shekarai</b>
<a href="#" class="zbtn zbtn-p">پیام بده در بله<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
</div>

<div class="zch">
<div style="display: flex; align-items: center; justify-content: space-between">
<span style="width: 60px; height: 60px; border-radius: 20px; background: #111827; display: grid; place-items: center">

<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.9" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17" cy="7" r="1" fill="#111827"></circle></svg>
</span>
<span style="font-size: 12px; font-weight: 700; color: #0F766E; background: #E6F4F1; padding: 4px 10px; border-radius: 999px">دنبالمون کن</span>
</div>
<div><b style="font-size: 22px; display: block">اینستاگرام</b><span style="color: #6B7280; font-size: 14px">خبرها و نکته‌های خرید ماشین</span></div>
<b dir="ltr" style="font-size: 18px; color: #0F766E; text-align: right">@@shekarai</b>
<a href="#" class="zbtn zbtn-g">دیدن پیج<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
</div>

</section>

<section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 20px">
<div style="background: #F6F8F8; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 16px">
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap"><b style="font-size: 20px">ساعت پشتیبانی</b><b style="font-size: 20px; color: #0F766E">۹ صبح تا ۶ عصر</b></div>
<div dir="ltr" style="position: relative; height: 40px">
<div style="position: absolute; top: 14px; left: 0; right: 0; height: 12px; border-radius: 999px; background: #E5E7EB"></div>
<div style="position: absolute; top: 14px; left: 37.5%; width: 37.5%; height: 12px; border-radius: 999px; background: #0F766E"></div>
<div style="position: absolute; top: 4px; left: 43.5%; transform: translateX(-50%); width: 4px; height: 32px; border-radius: 4px; background: #134E4A"></div>
</div>
<div dir="ltr" style="position: relative; height: 20px; font-size: 12px; color: #6B7280; margin-top: -10px"><span style="position: absolute; left: 0">۰۰</span><span style="position: absolute; left: 37.5%; transform: translateX(-50%); color: #0F766E; font-weight: 700">۹:۰۰</span><span style="position: absolute; left: 75%; transform: translateX(-50%); color: #0F766E; font-weight: 700">۱۸:۰۰</span><span style="position: absolute; right: 0">۲۴</span></div>
<span style="font-size: 14px; color: #374151; display: flex; align-items: center; gap: 8px"><span style="width: 12px; height: 12px; border-radius: 4px; background: #134E4A"></span>الان ساعت ۱۰:۲۷ به وقت تهرانه · آنلاینیم</span>
</div>
<div style="background: #FBF6E6; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 12px; justify-content: center">
<b style="font-size: 20px">شاید جوابت همین‌جا باشه</b>
<span style="color: #374151; line-height: 1.8">قیمت پلن‌ها، پیامک «خبرم کن» و امتیاز شکار رو تو سؤال‌های پرتکرار توضیح دادیم.</span>
<a href="index.html#faq" style="align-self: flex-start; font-weight: 700; min-height: 44px; display: flex; align-items: center; gap: 6px">دیدن سؤال‌های پرتکرار<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
</div>
</section>
<p style="margin: 0; text-align: center; color: #6B7280; font-size: 14px">بیرون از ساعت پشتیبانی هم پیام بذار؛ فردا از ۹ صبح اول به تو جواب می‌دیم.</p>
</main>
</div>
