@model PlansViewModel
@{
    ViewData["Title"] = "پلن‌ها";
    var hunter = Model.Plans.First(p => p.Type == PlanType.Hunter);
    var pro = Model.Plans.First(p => p.Type == PlanType.HunterPro);
    var cap = Model.Capacity;
    int usedPct = cap.Capacity == 0 ? 0 : (int)Math.Round(cap.Used * 100.0 / cap.Capacity);
    string btn = "width: 100%; border: 0; cursor: pointer; font-family: inherit; display: flex; align-items: center; justify-content: center";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/plans.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh">
<header style="position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid #EEF0F2">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 32px; min-height: 72px; display: flex; align-items: center; gap: 36px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827"><svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 22px">شکار</b></a>
<nav aria-label="منوی اصلی" style="display: flex; gap: 28px; flex: 1"><a href="/hunts" style="color: #374151; font-weight: 500">شکارها</a><a href="/appraise" style="color: #374151; font-weight: 500">کارشناسی قیمت</a><a href="/plans" aria-current="page" style="color: #0F766E; font-weight: 700">پلن‌ها</a><a href="/contact" style="color: #374151; font-weight: 500">تماس با ما</a></nav>
<a href="/account" aria-label="حساب کاربری" style="width: 44px; height: 44px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></a>
</div>
</header>

<main style="max-width: 1040px; margin: 0 auto; padding: 56px 24px 96px; display: flex; flex-direction: column; align-items: center; gap: 32px">

@* ── عنوان ── *@
<div style="text-align: center; display: flex; flex-direction: column; gap: 10px">
<h1 style="margin: 0; font-size: 40px; font-weight: 800">پلنت رو انتخاب کن</h1>
<p style="margin: 0; color: #6B7280; font-size: 18px">شکارها رو قبل از همه ببین و جلو بیفت.</p>
</div>

@* ── بنر ۲۴ ساعت رایگان ── *@
<div style="display: flex; align-items: center; gap: 12px; background: #FBF6E6; border: 1px solid #F1DFA6; border-radius: 16px; padding: 12px 20px; color: #3F3305">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8A6A0B" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"></rect><path d="M3 12h18M12 8v13M12 8c-2-4-6-4-6-1.5S9 8 12 8zM12 8c2-4 6-4 6-1.5S15 8 12 8z"></path></svg>
<span style="font-size: 16px"><b>۲۴ ساعت اول مهمون ما!</b> هر پلنی رو انتخاب کنی، یه روز کامل رایگان امتحانش کن.</span>
</div>

@* ── شهر و پرداخت ── *@
<span style="display: inline-flex; align-items: center; gap: 6px; background: #E6F4F1; color: #0F766E; font-weight: 700; font-size: 14px; padding: 6px 14px; border-radius: 999px">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
شهر تو: @cap.CityName · پرداخت ماهانه
</span>

@* ── ظرفیت ── *@
<div style="width: 100%; max-width: 560px; display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; justify-content: space-between; font-size: 15px">
<b>هر شهر فقط @ViewFormat.Digits(cap.Capacity.ToString()) اشتراک داره</b>
<span style="color: #DC2626; font-weight: 700">@cap.CityName: فقط @ViewFormat.Digits(cap.Remaining.ToString()) جا مونده</span>
</div>
<div role="progressbar" aria-valuenow="@usedPct" aria-valuemin="0" aria-valuemax="100" aria-label="ظرفیت پرشده‌ی @cap.CityName" style="height: 12px; border-radius: 999px; background: #E6F4F1; overflow: hidden">
<div style="width: @(usedPct)%; height: 100%; background: #0F766E; border-radius: 999px"></div>
</div>
</div>

@if (TempData["PlansMsg"] is string msg)
{
    <div style="width: 100%; max-width: 720px; background: #FEF3C7; color: #92400E; border-radius: 12px; padding: 12px 16px; font-size: 14px; text-align: center">@msg</div>
}

@* ── کارت‌های پلن ── *@
<div style="width: 100%; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 24px; align-items: stretch">

@* ── شکارچی ── *@
<div class="zplan" style="border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 16px; background: #FFFFFF">
<b style="font-size: 24px">@hunter.Name</b>
<div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap"><span style="font-size: 36px; font-weight: 800">@ViewFormat.Number(hunter.MonthlyPriceToman)</span><span style="color: #6B7280">تومان / ماه</span></div>
<span style="color: #6B7280; font-size: 14px; min-height: 22px">برای شروع کافیه</span>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; flex: 1">
@foreach (var feat in hunter.Features)
{
<li style="display: flex; align-items: center; gap: 10px; color: #111827">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2.6" stroke-linecap="round" aria-label="دارد" role="img"><path d="M5 12l5 5 9-10"></path></svg>
<span>@feat</span>
</li>
}
@if (!hunter.HasBellAlerts)
{
<li style="display: flex; align-items: center; gap: 10px; color: #6B7280">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2.6" stroke-linecap="round" aria-label="ندارد" role="img"><path d="M6 12h12"></path></svg>
<span>پیامک شکارهای تازه‌ی هر دسته</span>
</li>
}
</ul>
<form method="post" action="/plans/trial" style="margin: 0"><button type="submit" class="zbtn zbtn-s" style="@btn">۲۴ ساعت رایگان امتحان کن</button></form>
<span style="font-size: 13px; color: #6B7280; text-align: center">بعدش @ViewFormat.Number(hunter.MonthlyPriceToman) تومان در ماه · <a href="/plans/subscribe?plan=Hunter" style="font-weight: 700">یا همین الان پرداخت کن</a></span>
</div>

@* ── شکارچی حرفه‌ای ── *@
<div class="zplan zplan-rec" style="border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 16px; position: relative; background: #FFFFFF">
<span style="position: absolute; top: -14px; right: 28px; background: #0F766E; color: #FFFFFF; font-size: 13px; font-weight: 700; padding: 4px 14px; border-radius: 999px">پیشنهادی</span>
<b style="font-size: 24px">@pro.Name</b>
<div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap"><span style="font-size: 36px; font-weight: 800">@ViewFormat.Number(pro.MonthlyPriceToman)</span><span style="color: #6B7280">تومان / ماه</span></div>
<span style="color: #6B7280; font-size: 14px; min-height: 22px">همه‌چیز + پیامک شکارهای تازه</span>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; flex: 1">
@foreach (var feat in pro.Features)
{
<li style="display: flex; align-items: center; gap: 10px; color: #111827">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2.6" stroke-linecap="round" aria-label="دارد" role="img"><path d="M5 12l5 5 9-10"></path></svg>
<span>@feat</span>
</li>
}
@if (pro.HasBellAlerts)
{
<li style="display: flex; align-items: center; gap: 10px; color: #111827">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2.6" stroke-linecap="round" aria-label="دارد" role="img"><path d="M5 12l5 5 9-10"></path></svg>
<span>پیامک شکارهای تازه‌ی هر دسته</span><b style="margin-right: auto; font-size: 14px">۲۴ ساعته</b>
</li>
}
</ul>
<form method="post" action="/plans/subscribe" style="margin: 0"><input type="hidden" name="plan" value="HunterPro"><button type="submit" class="zbtn zbtn-p" style="@btn">۲۴ ساعت رایگان امتحان کن</button></form>
<span style="font-size: 13px; color: #6B7280; text-align: center">بعدش @ViewFormat.Number(pro.MonthlyPriceToman) تومان در ماه · <a href="/plans/subscribe?plan=HunterPro" style="font-weight: 700">یا همین الان پرداخت کن</a></span>
</div>

</div>

@* ── لینک کارشناسی رایگان ── *@
<a href="/appraise" style="width: 100%; border: 1.5px dashed #0F766E; border-radius: 16px; padding: 16px 20px; display: flex; gap: 12px; align-items: center; color: #111827">
<span style="width: 40px; height: 40px; border-radius: 12px; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"></path></svg></span>
<span style="flex: 1; font-size: 15px"><b>هنوز مطمئن نیستی؟</b> بدون اشتراک و فقط با ثبت‌نام، <b style="color: #0F766E">ماهی ۳ آگهی رو رایگان کارشناسی کن.</b></span>
<b style="color: #0F766E; white-space: nowrap">امتحان کن ←</b>
</a>

@* ── توضیح خبرم‌کن ── *@
<div style="width: 100%; background: #E6F4F1; border-radius: 16px; padding: 16px 20px; display: flex; gap: 12px; align-items: center">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="1.8" aria-hidden="true" style="flex: none"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path><path d="M10 20.5a2 2 0 004 0"></path></svg>
<span style="font-size: 15px"><b>«خبرم کن» چطوریه؟</b> زنگوله‌ی هر دسته رو بزنی، تا ۲۴ ساعت هر شکار تازه‌ی اون دسته رو برات پیامک می‌کنیم.</span>
</div>

<p style="margin: 0; color: #6B7280; font-size: 14px">فقط پرداخت ماهانه · پرداخت امن با درگاه بانکی · هر ماه خودت تمدید کن</p>
</main>
</div>
