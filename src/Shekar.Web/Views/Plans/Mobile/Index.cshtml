@model PlansViewModel
@{
    ViewData["Title"] = "پلن‌ها";
    var hunter = Model.Plans.First(p => p.Type == PlanType.Hunter);
    var pro = Model.Plans.First(p => p.Type == PlanType.HunterPro);
    var cap = Model.Capacity;
    int usedPct = cap.Capacity == 0 ? 0 : (int)Math.Round(cap.Used * 100.0 / cap.Capacity);
    double ringDash = usedPct * 226.2 / 100.0;
    string btn = "width: 100%; border: 0; cursor: pointer; font-family: inherit; display: flex; align-items: center; justify-content: center; min-height: 52px";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/plans.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #F6F8F8; display: flex; flex-direction: column">

<header style="padding: 12px 16px; display: flex; align-items: center; gap: 12px; background: #FFFFFF; position: sticky; top: 0; z-index: 5">
<a href="/" aria-label="بازگشت" style="width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #F6F8F8"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
<b style="font-size: 18px">پلن‌ها</b>
</header>

<main style="padding: 0 16px 24px; display: flex; flex-direction: column; gap: 16px; flex: 1; padding-bottom: 100px">

@* ── هدر با حلقه ظرفیت ── *@
<section style="margin: 0 -16px; background: #FFFFFF; padding: 8px 16px 20px; display: flex; flex-direction: column; gap: 16px; border-radius: 0 0 28px 28px">
<div style="display: flex; align-items: center; gap: 16px">
<div style="flex: 1; display: flex; flex-direction: column; gap: 6px">
<h1 style="margin: 0; font-size: 26px; font-weight: 800; line-height: 1.4">پلنت رو انتخاب کن</h1>
<p style="margin: 0; color: #6B7280; font-size: 14px">شکارها رو قبل از همه ببین و جلو بیفت.</p>
</div>
<div role="img" aria-label="@ViewFormat.Digits(cap.Remaining.ToString()) جا از @ViewFormat.Digits(cap.Capacity.ToString()) جای @cap.CityName مونده" style="position: relative; width: 86px; height: 86px; flex: none">
<svg width="86" height="86" viewBox="0 0 86 86" aria-hidden="true"><circle cx="43" cy="43" r="36" fill="none" stroke="#E6F4F1" stroke-width="9"></circle><circle cx="43" cy="43" r="36" fill="none" stroke="#0F766E" stroke-width="9" stroke-linecap="round" stroke-dasharray="@ringDash 226.2" transform="rotate(-90 43 43)"></circle></svg>
<div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.2"><b style="font-size: 20px; color: #0F766E">@ViewFormat.Digits(cap.Remaining.ToString())</b><span style="font-size: 11px; color: #6B7280">جا تو @cap.CityName</span></div>
</div>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; background: #F6F8F8; border-radius: 12px; padding: 10px 12px; font-size: 13px">
<span>از هر شهر فقط <b>@ViewFormat.Digits(cap.Capacity.ToString()) نفر</b> عضو می‌شن.</span>
<span style="display: inline-flex; align-items: center; gap: 4px; background: #E6F4F1; color: #0F766E; font-weight: 700; font-size: 12px; padding: 3px 9px; border-radius: 999px; white-space: nowrap"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>@cap.CityName</span>
</div>

<div style="display: flex; align-items: center; gap: 10px; background: #FBF6E6; border: 1px solid #F1DFA6; border-radius: 14px; padding: 10px 12px; color: #3F3305; font-size: 13px; line-height: 1.7">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#8A6A0B" stroke-width="2" stroke-linejoin="round" aria-hidden="true" style="flex: none"><rect x="3" y="8" width="18" height="13" rx="2"></rect><path d="M3 12h18M12 8v13M12 8c-2-4-6-4-6-1.5S9 8 12 8zM12 8c2-4 6-4 6-1.5S15 8 12 8z"></path></svg>
<span><b>۲۴ ساعت اول مهمون ما!</b> هر پلنی رو انتخاب کنی، یه روز کامل رایگانه. <a href="/plans" style="font-weight: 700">یا الان پرداخت کن</a></span>
</div>
</section>

@if (TempData["PlansMsg"] is string msg)
{
    <div style="background: #FBF6E6; color: #8A6A0B; border: 1px solid #F1DFA6; border-radius: 12px; padding: 10px 12px; font-size: 13px; text-align: center">@msg</div>
}

@* ── کارت‌های پلن (radio-style) ── *@
<div role="radiogroup" aria-label="انتخاب پلن" style="display: flex; flex-direction: column; gap: 14px; padding-top: 6px">

@* ── شکارچی حرفه‌ای (پیشنهادی) ── *@
<button role="radio" aria-checked="true" class="zpl zpl-on">
<span style="position: absolute; top: -12px; right: 18px; background: #0F766E; color: #FFFFFF; font-size: 12px; font-weight: 700; padding: 3px 12px; border-radius: 999px">پیشنهاد ما</span>
<span style="display: flex; align-items: center; gap: 10px; width: 100%"><span class="zrad zrad-on"></span><span style="flex: 1; display: flex; flex-direction: column"><b style="font-size: 18px">@pro.Name</b><span style="font-size: 12px; color: #6B7280">همه‌چیز + پیامک شکارهای تازه</span></span></span>
<span style="display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap"><b style="font-size: 30px; letter-spacing: -.5px">@ViewFormat.Number(pro.MonthlyPriceToman)</b><span style="color: #6B7280; font-size: 13px">تومان / ماه</span></span>
<span style="height: 1px; background: #EEF0F2; width: 100%"></span>
<span style="display: flex; flex-direction: column; gap: 8px; font-size: 14px; width: 100%">
@foreach (var feat in pro.Features)
{
<span style="display: flex; align-items: center; gap: 8px; color: #111827">
<span style="width: 20px; height: 20px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="3.2" role="img" aria-label="دارد"><path d="M5 12l5 5 9-10"></path></svg></span>
<span style="flex: 1">@feat</span>
</span>
}
@if (pro.HasBellAlerts)
{
<span style="display: flex; align-items: center; gap: 8px; color: #111827">
<span style="width: 20px; height: 20px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="3.2" role="img" aria-label="دارد"><path d="M5 12l5 5 9-10"></path></svg></span>
<span style="flex: 1">پیامک شکارهای تازه‌ی هر دسته</span><b style="font-size: 12px">۲۴ ساعته</b>
</span>
}
</span>
</button>

@* ── شکارچی ── *@
<button role="radio" aria-checked="false" class="zpl">
<span style="display: flex; align-items: center; gap: 10px; width: 100%"><span class="zrad"></span><span style="flex: 1; display: flex; flex-direction: column"><b style="font-size: 18px">@hunter.Name</b><span style="font-size: 12px; color: #6B7280">برای شروع کافیه</span></span></span>
<span style="display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap"><b style="font-size: 30px; letter-spacing: -.5px">@ViewFormat.Number(hunter.MonthlyPriceToman)</b><span style="color: #6B7280; font-size: 13px">تومان / ماه</span></span>
<span style="height: 1px; background: #EEF0F2; width: 100%"></span>
<span style="display: flex; flex-direction: column; gap: 8px; font-size: 14px; width: 100%">
@foreach (var feat in hunter.Features)
{
<span style="display: flex; align-items: center; gap: 8px; color: #111827">
<span style="width: 20px; height: 20px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="3.2" role="img" aria-label="دارد"><path d="M5 12l5 5 9-10"></path></svg></span>
<span style="flex: 1">@feat</span>
</span>
}
@if (!hunter.HasBellAlerts)
{
<span style="display: flex; align-items: center; gap: 8px; color: #6B7280">
<span style="width: 20px; height: 20px; border-radius: 50%; background: #F3F4F6; display: grid; place-items: center; flex: none"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="3.2" role="img" aria-label="ندارد"><path d="M6 12h12"></path></svg></span>
<span style="flex: 1">پیامک شکارهای تازه‌ی هر دسته</span>
</span>
}
</span>
</button>

</div>

@* ── لینک کارشناسی رایگان ── *@
<a href="/appraise" style="border: 1.5px dashed #0F766E; background: #FFFFFF; border-radius: 20px; padding: 14px; display: flex; gap: 12px; align-items: center; color: #111827">
<span style="width: 36px; height: 36px; border-radius: 10px; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"></path></svg></span>
<span style="flex: 1; font-size: 13px; line-height: 1.8"><b>هنوز مطمئن نیستی؟</b><br>بدون اشتراک، فقط با ثبت‌نام <b style="color: #0F766E">ماهی ۳ کارشناسی رایگان</b> داری.</span>
<b style="color: #0F766E; font-size: 13px">←</b>
</a>

@* ── توضیح خبرم‌کن ── *@
<div style="background: #FFFFFF; border-radius: 20px; padding: 14px; display: flex; gap: 12px; align-items: flex-start">
<span style="width: 36px; height: 36px; border-radius: 10px; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="1.9" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path><path d="M10 20.5a2 2 0 004 0"></path></svg></span>
<span style="font-size: 13px; line-height: 1.8"><b>«خبرم کن» چیه؟</b><br>تو پلن حرفه‌ای، زنگوله‌ی هر دسته رو بزنی، تا ۲۴ ساعت هر شکار تازه‌ش رو همون لحظه پیامک می‌کنیم.</span>
</div>

@* ── آیکون‌های اعتماد ── *@
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; text-align: center; font-size: 12px; color: #374151">
<div style="background: #FFFFFF; border-radius: 14px; padding: 12px 6px; display: flex; flex-direction: column; align-items: center; gap: 6px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 018 0v4"></path></svg>پرداخت امن بانکی</div>
<div style="background: #FFFFFF; border-radius: 14px; padding: 12px 6px; display: flex; flex-direction: column; align-items: center; gap: 6px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 1015.5-6.2M21 4v5h-5"></path></svg>تمدید هر وقت خواستی</div>
<a href="/contact" style="background: #FFFFFF; border-radius: 14px; padding: 12px 6px; display: flex; flex-direction: column; align-items: center; gap: 6px; color: #374151"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg><span>پشتیبانی ۹ تا ۶</span></a>
</div>
</main>

@* ── دکمه sticky پایین ── *@
<div style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; background: #FFFFFF; border-top: 1px solid #EEF0F2; padding: 12px 16px 20px; box-shadow: 0 -8px 24px rgba(17,24,39,.06)">
<div style="max-width: 480px; margin: 0 auto; display: flex; align-items: center; gap: 12px">
<div style="flex: 1; min-width: 0; display: flex; flex-direction: column"><span style="font-size: 12px; color: #8A6A0B; font-weight: 700">۲۴ ساعت رایگان، بعدش ماهانه</span><b style="font-size: 16px; white-space: nowrap">@ViewFormat.Number(pro.MonthlyPriceToman) <span style="font-size: 12px; font-weight: 500; color: #6B7280">تومان</span></b></div>
<form method="post" action="/plans/trial" style="margin: 0; flex: none"><button type="submit" class="zbtn zbtn-p" style="@btn; padding: 0 24px">شروع ۲۴ ساعت رایگان</button></form>
</div>
</div>

</div>
